module Math;

import pascal Math;

interface

extern function sqrt(borrow x: Float64) return Float64;
extern function pow(borrow base, exp: Float64) return Float64;

type
    MathError = enum
        DivisaoPorZero,
        DominioInvalido
    end;

function Abs(borrow x: Float64) return Float64;
function Max(borrow a, b: Float64) return Float64;
function Min(borrow a, b: Float64) return Float64;
function Clamp(borrow val, min_val, max_val: Float64) return Float64
contract
    require
        min_val <= max_val;
    ensure
        true;
function SqrtSafe(borrow x: Float64) return Result<Float64, MathError>;

implementation

function Abs(borrow x: Float64) return Float64 is
begin
    if x < 0.0 then
        return 0.0 - x;
    else
        return x;
    end;
end Abs;

function Max(borrow a, b: Float64) return Float64 is
begin
    if a > b then
        return a;
    else
        return b;
    end;
end Max;

function Min(borrow a, b: Float64) return Float64 is
begin
    if a < b then
        return a;
    else
        return b;
    end;
end Min;

function Clamp(borrow val, min_val, max_val: Float64) return Float64 is
begin
    if val < min_val then
        return min_val;
    else
        if val > max_val then
            return max_val;
        else
            return val;
        end;
    end;
end Clamp;

function SqrtSafe(borrow x: Float64) return Result<Float64, MathError> is
begin
    if x < 0.0 then
        return Err(MathError.DominioInvalido);
    else
        return Ok(sqrt(borrow x));
    end;
end SqrtSafe;

end Math.
