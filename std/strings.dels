module Strings;

interface

extern function puts(borrow s: String) return Int32;

function IsEmpty(borrow s: String) return Bool;
function Equals(borrow a, b: String) return Bool;
procedure PrintMessage(borrow prefix, msg: String);
function StrLen(borrow s: String) return UInt32;
function GetChar(borrow s: String; borrow pos: UInt32) return String;
function Substr(borrow s: String; borrow start, count: UInt32) return String;
function SplitBy(borrow s, sep: String) return array of String;
function JoinWith(borrow parts: array of String; borrow sep: String) return String;
function PadStart(borrow s: String; width: Int32; borrow pad: String) return String;
function PadEnd(borrow s: String; width: Int32; borrow pad: String) return String;
function RepeatText(borrow s: String; count: Int32) return String;
function ParseFloat(borrow s: String) return Float64;
function TryParseInt(borrow s: String) return Option<Int32>;
function TryParseFloat(borrow s: String) return Option<Float64>;

implementation

function IsEmpty(borrow s: String) return Bool is
begin
    if s = "" then
        return true;
    else
        return false;
    end if;
end IsEmpty;

function Equals(borrow a, b: String) return Bool is
begin
    if a = b then
        return true;
    else
        return false;
    end if;
end Equals;

procedure PrintMessage(borrow prefix, msg: String) is
begin
    PrintLn("[%s] %s", prefix, msg);
end PrintMessage;

function StrLen(borrow s: String) return UInt32 is
begin
    return Length(borrow s);
end StrLen;

function GetChar(borrow s: String; borrow pos: UInt32) return String is
begin
    return CharAt(borrow s, borrow pos);
end GetChar;

function Substr(borrow s: String; borrow start, count: UInt32) return String is
begin
    return Substring(borrow s, borrow start, borrow count);
end Substr;

function SplitBy(borrow s, sep: String) return array of String is
begin
    return Split(s, sep);
end SplitBy;

function JoinWith(borrow parts: array of String; borrow sep: String) return String is
begin
    return Join(parts, sep);
end JoinWith;

function PadStart(borrow s: String; width: Int32; borrow pad: String) return String is
begin
    return PadLeft(s, width, pad);
end PadStart;

function PadEnd(borrow s: String; width: Int32; borrow pad: String) return String is
begin
    return PadRight(s, width, pad);
end PadEnd;

function RepeatText(borrow s: String; count: Int32) return String is
begin
    return RepeatStr(s, count);
end RepeatText;

function ParseFloat(borrow s: String) return Float64 is
begin
    return StrToFloat(s);
end ParseFloat;

function TryParseInt(borrow s: String) return Option<Int32> is
begin
    return TryStrToInt(s);
end TryParseInt;

function TryParseFloat(borrow s: String) return Option<Float64> is
begin
    return TryStrToFloat(s);
end TryParseFloat;

end Strings.
