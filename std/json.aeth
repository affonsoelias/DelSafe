module JSON;

import Strings;

type
    JsonBuilder = record
        buffer: String;
        count: UInt32;
    end;

function NewJsonBuilder(): JsonBuilder
begin
    return JsonBuilder(buffer: "{", count: 0);
end;

function AddString(mut borrow jb: JsonBuilder; borrow key: String; borrow val: String): Void
begin
    if jb.count > 0 then
        jb.buffer := jb.buffer + ", ";
    else
        jb.buffer := jb.buffer + " ";
    end;
    jb.buffer := jb.buffer + "\"" + key + "\": \"" + val + "\"";
    jb.count := jb.count + 1;
end;

function AddInt(mut borrow jb: JsonBuilder; borrow key: String; borrow val: Int32): Void
begin
    if jb.count > 0 then
        jb.buffer := jb.buffer + ", ";
    else
        jb.buffer := jb.buffer + " ";
    end;
    jb.buffer := jb.buffer + "\"" + key + "\": " + IntToStr(borrow val);
    jb.count := jb.count + 1;
end;

function AddBool(mut borrow jb: JsonBuilder; borrow key: String; borrow val: Bool): Void
var
    b_str: String;
begin
    if val then
        b_str := "true";
    else
        b_str := "false";
    end;

    if jb.count > 0 then
        jb.buffer := jb.buffer + ", ";
    else
        jb.buffer := jb.buffer + " ";
    end;
    jb.buffer := jb.buffer + "\"" + key + "\": " + b_str;
    jb.count := jb.count + 1;
end;

function Build(borrow jb: JsonBuilder): String
begin
    if jb.count > 0 then
        return jb.buffer + " }";
    else
        return "{}";
    end;
end;

function FindSubstr(borrow haystack: String; borrow needle: String): Int32
var
    h_len: UInt32;
    n_len: UInt32;
    i: UInt32;
    sub: String;
begin
    h_len := Length(borrow haystack);
    n_len := Length(borrow needle);
    if (n_len = 0) or (n_len > h_len) then
        return -1;
    end;

    i := 0;
    while i <= (h_len - n_len) do
        sub := Substring(borrow haystack, i, n_len);
        if sub = needle then
            return Int32(i);
        end;
        i := i + 1;
    end;

    return -1;
end;

function HasKey(borrow json: String; borrow key: String): Bool
var
    needle: String;
    pos: Int32;
begin
    needle := "\"" + key + "\"";
    pos := FindSubstr(borrow json, borrow needle);
    return pos >= 0;
end;

function ExtractString(borrow json: String; borrow key: String; mut borrow out_val: String): Bool
var
    needle: String;
    pos: Int32;
    len: UInt32;
    curr: UInt32;
    val_start: UInt32;
    val_len: UInt32;
begin
    needle := "\"" + key + "\"";
    pos := FindSubstr(borrow json, borrow needle);
    if pos < 0 then
        return false;
    end;

    len := Length(borrow json);
    curr := UInt32(pos) + Length(borrow needle);

    // Pula espacos e ':' ate a abertura de aspas
    while (curr < len) and (CharAt(borrow json, curr) <> "\"") do
        curr := curr + 1;
    end;

    if curr >= len then
        return false;
    end;

    curr := curr + 1; // Pula aspas de abertura
    val_start := curr;

    while (curr < len) and (CharAt(borrow json, curr) <> "\"") do
        curr := curr + 1;
    end;

    if curr > len then
        return false;
    end;

    val_len := curr - val_start;
    out_val := Substring(borrow json, val_start, val_len);
    return true;
end;

function ExtractInt(borrow json: String; borrow key: String; mut borrow out_val: Int32): Bool
var
    needle: String;
    pos: Int32;
    len: UInt32;
    curr: UInt32;
    ch: String;
    val_start: UInt32;
    val_len: UInt32;
    num_str: String;
    searching: Bool;
begin
    needle := "\"" + key + "\"";
    pos := FindSubstr(borrow json, borrow needle);
    if pos < 0 then
        return false;
    end;

    len := Length(borrow json);
    curr := UInt32(pos) + Length(borrow needle);

    // Pula espacos e ':' ate achar o primeiro digito ou sinal negativo '-'
    searching := true;
    while (curr < len) and searching do
        ch := CharAt(borrow json, curr);
        if ((ch >= "0") and (ch <= "9")) or (ch = "-") then
            searching := false;
        else
            curr := curr + 1;
        end;
    end;

    if curr >= len then
        return false;
    end;

    val_start := curr;
    searching := true;
    while (curr < len) and searching do
        ch := CharAt(borrow json, curr);
        if ((ch >= "0") and (ch <= "9")) or (ch = "-") then
            curr := curr + 1;
        else
            searching := false;
        end;
    end;

    val_len := curr - val_start;
    num_str := Substring(borrow json, val_start, val_len);
    out_val := StrToInt(borrow num_str);
    return true;
end;

function ExtractBool(borrow json: String; borrow key: String; mut borrow out_val: Bool): Bool
var
    needle: String;
    pos: Int32;
    len: UInt32;
    curr: UInt32;
    four_chars: String;
    five_chars: String;
begin
    needle := "\"" + key + "\"";
    pos := FindSubstr(borrow json, borrow needle);
    if pos < 0 then
        return false;
    end;

    len := Length(borrow json);
    curr := UInt32(pos) + Length(borrow needle);

    while curr < len do
        if curr + 4 <= len then
            four_chars := Substring(borrow json, curr, 4);
            if four_chars = "true" then
                out_val := true;
                return true;
            end;
        end;
        if curr + 5 <= len then
            five_chars := Substring(borrow json, curr, 5);
            if five_chars = "false" then
                out_val := false;
                return true;
            end;
        end;
        curr := curr + 1;
    end;

    return false;
end;

function Validate(borrow json: String): Bool
var
    len: UInt32;
    i: UInt32;
    ch: String;
    chaves_abertas: Int32;
    colchetes_abertos: Int32;
begin
    len := Length(borrow json);
    chaves_abertas := 0;
    colchetes_abertos := 0;
    i := 0;

    while i < len do
        ch := CharAt(borrow json, i);
        if ch = "{" then chaves_abertas := chaves_abertas + 1; end;
        if ch = "}" then chaves_abertas := chaves_abertas - 1; end;
        if ch = "[" then colchetes_abertos := colchetes_abertos + 1; end;
        if ch = "]" then colchetes_abertos := colchetes_abertos - 1; end;
        if (chaves_abertas < 0) or (colchetes_abertos < 0) then
            return false;
        end;
        i := i + 1;
    end;

    return (chaves_abertas = 0) and (colchetes_abertos = 0);
end;
