module Strings;

extern function puts(borrow s: String): Int32;

function IsEmpty(borrow s: String): Bool
begin
    if s = "" then
        return true;
    else
        return false;
    end;
end;

function Equals(borrow a: String; borrow b: String): Bool
begin
    if a = b then
        return true;
    else
        return false;
    end;
end;

function PrintMessage(borrow prefix: String; borrow msg: String): Void
begin
    PrintLn("[%s] %s", prefix, msg);
end;

function Tamanho(borrow s: String): UInt32
begin
    return Length(borrow s);
end;

function Caractere(borrow s: String; borrow pos: UInt32): String
begin
    return CharAt(borrow s, borrow pos);
end;

function Fatia(borrow s: String; borrow inicio: UInt32; borrow qtd: UInt32): String
begin
    return Substring(borrow s, borrow inicio, borrow qtd);
end;
