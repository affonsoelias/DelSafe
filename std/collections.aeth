module Collections;

type
    FixedBuffer = record
        capacity: UInt32;
        count: UInt32;
    end;

    StringBuilder = record
        buffer: String;
        length: UInt32;
    end;

function NewBuffer(borrow cap: UInt32): FixedBuffer
begin
    return FixedBuffer(capacity: cap, count: 0);
end;

function IsFull(borrow buf: FixedBuffer): Bool
begin
    if buf.count >= buf.capacity then
        return true;
    else
        return false;
    end;
end;

function Available(borrow buf: FixedBuffer): UInt32
begin
    return buf.capacity - buf.count;
end;

function PushItem(mut borrow buf: FixedBuffer): Bool
begin
    if buf.count < buf.capacity then
        buf.count := buf.count + 1;
        return true;
    else
        return false;
    end;
end;

function NewStringBuilder(): StringBuilder
begin
    return StringBuilder(buffer: "", length: 0);
end;

function Append(mut borrow sb: StringBuilder; borrow text: String): Void
begin
    sb.buffer := sb.buffer + text;
    sb.length := sb.length + Length(borrow text);
end;

function ToString(borrow sb: StringBuilder): String
begin
    return sb.buffer;
end;
