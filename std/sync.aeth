module Sync;

interface

type
  AtomicInt32 = record
    handle: Pointer;
  end record;

  Mutex = record
    handle: Pointer;
    locked: Bool;
    holder_id: UInt32;
  end record;

function NewAtomic(initial: Int32) return AtomicInt32;
function AtomicLoad(borrow a: AtomicInt32) return Int32;
procedure AtomicStore(borrow a: AtomicInt32; val: Int32);
function AtomicFetchAdd(borrow a: AtomicInt32; delta: Int32) return Int32;
procedure AtomicAdd(borrow a: AtomicInt32; delta: Int32);
function AtomicCompareExchange(borrow a: AtomicInt32; expected, desired: Int32) return Bool;
procedure AtomicDestroy(mut borrow a: AtomicInt32);

function NewMutex() return Mutex;
procedure Lock(mut borrow m: Mutex);
procedure Unlock(mut borrow m: Mutex);
function IsLocked(borrow m: Mutex) return Bool;
procedure MutexLock(borrow m: Mutex);
function MutexTryLock(borrow m: Mutex) return Bool;
procedure MutexUnlock(borrow m: Mutex);
procedure MutexDestroy(mut borrow m: Mutex);

implementation

function NewAtomic(initial: Int32) return AtomicInt32 is
var
  res: AtomicInt32;
begin
  res.handle := __SyncAtomicNew(initial);
  return res;
end NewAtomic;

function AtomicLoad(borrow a: AtomicInt32) return Int32 is
begin
  return __SyncAtomicLoad(a.handle);
end AtomicLoad;

procedure AtomicStore(borrow a: AtomicInt32; val: Int32) is
begin
  __SyncAtomicStore(a.handle, val);
end AtomicStore;

function AtomicFetchAdd(borrow a: AtomicInt32; delta: Int32) return Int32 is
begin
  return __SyncAtomicAdd(a.handle, delta);
end AtomicFetchAdd;

procedure AtomicAdd(borrow a: AtomicInt32; delta: Int32) is
var
  ignored: Int32;
begin
  ignored := __SyncAtomicAdd(a.handle, delta);
end AtomicAdd;

function AtomicCompareExchange(borrow a: AtomicInt32; expected, desired: Int32) return Bool is
begin
  return __SyncAtomicCas(a.handle, expected, desired);
end AtomicCompareExchange;

procedure AtomicDestroy(mut borrow a: AtomicInt32) is
begin
  __SyncAtomicFree(a.handle);
  a.handle := nil;
end AtomicDestroy;

function NewMutex() return Mutex is
var
  m: Mutex;
begin
  m.handle := __SyncMutexNew();
  m.locked := false;
  m.holder_id := 0;
  return m;
end NewMutex;

procedure Lock(mut borrow m: Mutex) is
begin
  __SyncMutexLock(m.handle);
  m.locked := true;
  m.holder_id := 1;
end Lock;

procedure Unlock(mut borrow m: Mutex) is
begin
  m.locked := false;
  m.holder_id := 0;
  __SyncMutexUnlock(m.handle);
end Unlock;

function IsLocked(borrow m: Mutex) return Bool is
begin
  return m.locked;
end IsLocked;

procedure MutexLock(borrow m: Mutex) is
begin
  __SyncMutexLock(m.handle);
end MutexLock;

function MutexTryLock(borrow m: Mutex) return Bool is
begin
  return __SyncMutexTryLock(m.handle);
end MutexTryLock;

procedure MutexUnlock(borrow m: Mutex) is
begin
  __SyncMutexUnlock(m.handle);
end MutexUnlock;

procedure MutexDestroy(mut borrow m: Mutex) is
begin
  __SyncMutexFree(m.handle);
  m.handle := nil;
  m.locked := false;
  m.holder_id := 0;
end MutexDestroy;

end Sync.
