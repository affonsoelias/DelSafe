module Sync;

interface

type
    AtomicInt32 = record
        val: Int32;
    end;

    Mutex = record
        locked: Bool;
        holder_id: UInt32;
    end;

    Channel = record
        capacity: UInt32;
        count: UInt32;
        head: UInt32;
        tail: UInt32;
        is_closed: Bool;
    end;

function NewAtomic(borrow initial: Int32) return AtomicInt32;
function AtomicLoad(borrow a: AtomicInt32) return Int32;
procedure AtomicStore(mut borrow a: AtomicInt32; borrow new_val: Int32);
function AtomicAdd(mut borrow a: AtomicInt32; borrow delta: Int32) return Int32;
function NewMutex() return Mutex;
function Lock(mut borrow m: Mutex; borrow thread_id: UInt32) return Bool;
function Unlock(mut borrow m: Mutex; borrow thread_id: UInt32) return Bool;
function IsLocked(borrow m: Mutex) return Bool;
function NewChannel(borrow cap: UInt32) return Channel;
function Send(mut borrow ch: Channel) return Bool;
function Recv(mut borrow ch: Channel) return Bool;
function IsChannelEmpty(borrow ch: Channel) return Bool;
function IsChannelFull(borrow ch: Channel) return Bool;
procedure CloseChannel(mut borrow ch: Channel);

implementation

function NewAtomic(borrow initial: Int32) return AtomicInt32 is
begin
    return AtomicInt32(val: initial);
end NewAtomic;

function AtomicLoad(borrow a: AtomicInt32) return Int32 is
begin
    return a.val;
end AtomicLoad;

procedure AtomicStore(mut borrow a: AtomicInt32; borrow new_val: Int32) is
begin
    a.val := new_val;
end AtomicStore;

function AtomicAdd(mut borrow a: AtomicInt32; borrow delta: Int32) return Int32 is
begin
    a.val := a.val + delta;
    return a.val;
end AtomicAdd;

function NewMutex() return Mutex is
begin
    return Mutex(locked: false, holder_id: 0);
end NewMutex;

function Lock(mut borrow m: Mutex; borrow thread_id: UInt32) return Bool is
begin
    if not m.locked then
        m.locked := true;
        m.holder_id := thread_id;
        return true;
    else
        return false;
    end;
end Lock;

function Unlock(mut borrow m: Mutex; borrow thread_id: UInt32) return Bool is
begin
    if m.locked and (m.holder_id = thread_id) then
        m.locked := false;
        m.holder_id := 0;
        return true;
    else
        return false;
    end;
end Unlock;

function IsLocked(borrow m: Mutex) return Bool is
begin
    return m.locked;
end IsLocked;

function NewChannel(borrow cap: UInt32) return Channel is
begin
    return Channel(capacity: cap, count: 0, head: 0, tail: 0, is_closed: false);
end NewChannel;

function Send(mut borrow ch: Channel) return Bool is
begin
    if ch.is_closed or (ch.count >= ch.capacity) then
        return false;
    else
        ch.count := ch.count + 1;
        ch.tail := (ch.tail + 1) mod ch.capacity;
        return true;
    end;
end Send;

function Recv(mut borrow ch: Channel) return Bool is
begin
    if ch.count = 0 then
        return false;
    else
        ch.count := ch.count - 1;
        ch.head := (ch.head + 1) mod ch.capacity;
        return true;
    end;
end Recv;

function IsChannelEmpty(borrow ch: Channel) return Bool is
begin
    return ch.count = 0;
end IsChannelEmpty;

function IsChannelFull(borrow ch: Channel) return Bool is
begin
    return ch.count >= ch.capacity;
end IsChannelFull;

procedure CloseChannel(mut borrow ch: Channel) is
begin
    ch.is_closed := true;
end CloseChannel;

end Sync.
