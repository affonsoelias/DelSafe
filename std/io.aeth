module IO;

interface

type
    IOError = enum
        FileNotFound,
        PermissionDenied,
        DiskError
    end;

procedure Informar(borrow mensagem: String);
function ExisteArquivo(borrow path: String) return Bool;
function LerArquivo(borrow path: String) return String;
function GravarArquivo(borrow path, conteudo: String) return Bool;

implementation

procedure Informar(borrow mensagem: String) is
begin
    PrintLn("[IO]: %s", mensagem);
end Informar;

function ExisteArquivo(borrow path: String) return Bool is
begin
    return FileExists(borrow path);
end ExisteArquivo;

function LerArquivo(borrow path: String) return String is
begin
    return ReadFile(borrow path);
end LerArquivo;

function GravarArquivo(borrow path, conteudo: String) return Bool is
begin
    return WriteFile(borrow path, borrow conteudo);
end GravarArquivo;

end IO.
