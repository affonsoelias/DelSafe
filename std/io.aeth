module IO;

interface

type
    IOError = enum
        FileNotFound,
        PermissionDenied,
        DiskError
    end enum;

procedure LogInfo(borrow message: String);
procedure WriteOut(borrow text: String);
function ReadLine() return String;
function GetEnvVar(borrow name: String) return String;
function SetEnvVar(borrow name, value: String) return Bool;
function Exists(borrow path: String) return Bool;
function ReadAll(borrow path: String) return String;
function WriteAll(borrow path, content: String) return Bool;

implementation

procedure LogInfo(borrow message: String) is
begin
    PrintLn("[IO]: %s", message);
end LogInfo;

procedure WriteOut(borrow text: String) is
begin
    Print(text);
end WriteOut;

function ReadLine() return String is
begin
    return ReadLn();
end ReadLine;

function GetEnvVar(borrow name: String) return String is
begin
    return GetEnv(name);
end GetEnvVar;

function SetEnvVar(borrow name, value: String) return Bool is
begin
    return SetEnv(name, value);
end SetEnvVar;

function Exists(borrow path: String) return Bool is
begin
    return FileExists(borrow path);
end Exists;

function ReadAll(borrow path: String) return String is
begin
    return ReadFile(borrow path);
end ReadAll;

function WriteAll(borrow path, content: String) return Bool is
begin
    return WriteFile(borrow path, borrow content);
end WriteAll;

end IO.
