module FS;

interface

type
    FileInfo = record
        path: String;
        size_bytes: Int64;
        exists: Bool;
        is_dir: Bool;
    end record;

function MakeDir(borrow path: String) return Bool;
function DeleteDir(borrow path: String) return Bool;
function RemoveFile(borrow path: String) return Bool;
function HasDir(borrow path: String) return Bool;
function GetFileSize(borrow path: String) return Int64;
function ReadDir(borrow path: String) return array of String;
function CopyFileTo(borrow src, dst: String) return Bool;
function MoveFile(borrow old_path, new_path: String) return Bool;
function GetFileInfo(borrow path: String) return FileInfo;

implementation

function MakeDir(borrow path: String) return Bool is
begin
    return CreateDir(borrow path);
end MakeDir;

function DeleteDir(borrow path: String) return Bool is
begin
    return RemoveDir(borrow path);
end DeleteDir;

function RemoveFile(borrow path: String) return Bool is
begin
    return DeleteFile(borrow path);
end RemoveFile;

function HasDir(borrow path: String) return Bool is
begin
    return DirExists(borrow path);
end HasDir;

function GetFileSize(borrow path: String) return Int64 is
begin
    return FileSize(borrow path);
end GetFileSize;

function ReadDir(borrow path: String) return array of String is
begin
    return ListDir(path);
end ReadDir;

function CopyFileTo(borrow src, dst: String) return Bool is
begin
    return CopyFile(src, dst);
end CopyFileTo;

function MoveFile(borrow old_path, new_path: String) return Bool is
begin
    return RenameFile(old_path, new_path);
end MoveFile;

function GetFileInfo(borrow path: String) return FileInfo is
var
    ex: Bool;
    is_d: Bool;
    sz: Int64;
begin
    is_d := DirExists(borrow path);
    ex := is_d or FileExists(borrow path);
    if is_d then
        sz := 0;
    else
        sz := FileSize(borrow path);
    end if;
    return FileInfo(path: path, size_bytes: sz, exists: ex, is_dir: is_d);
end GetFileInfo;

end FS.
