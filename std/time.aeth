module Time;

interface

type
    Timer = record
        start_ns: UInt64;
        stop_ns: UInt64;
        is_running: Bool;
    end;

function AgoraNanosegundos() return UInt64;
procedure Dormir(ms: UInt32);
function NovoTimer() return Timer;
procedure Iniciar(mut borrow t: Timer);
function Parar(mut borrow t: Timer) return UInt64;
function DecorridoNs(borrow t: Timer) return UInt64;
function DecorridoMs(borrow t: Timer) return UInt64;

implementation

function AgoraNanosegundos() return UInt64 is
begin
    return GetNanoseconds();
end AgoraNanosegundos;

procedure Dormir(ms: UInt32) is
begin
    SleepMs(ms);
end Dormir;

function NovoTimer() return Timer is
begin
    return Timer(start_ns: 0, stop_ns: 0, is_running: false);
end NovoTimer;

procedure Iniciar(mut borrow t: Timer) is
begin
    t.start_ns := GetNanoseconds();
    t.stop_ns := 0;
    t.is_running := true;
end Iniciar;

function Parar(mut borrow t: Timer) return UInt64 is
begin
    t.stop_ns := GetNanoseconds();
    t.is_running := false;
    return t.stop_ns - t.start_ns;
end Parar;

function DecorridoNs(borrow t: Timer) return UInt64 is
begin
    if t.is_running then
        return GetNanoseconds() - t.start_ns;
    else
        return t.stop_ns - t.start_ns;
    end;
end DecorridoNs;

function DecorridoMs(borrow t: Timer) return UInt64 is
begin
    return DecorridoNs(borrow t) / 1000000;
end DecorridoMs;

end Time.
