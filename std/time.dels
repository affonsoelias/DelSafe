module Time;

interface

type
    Timer = record
        start_ns: UInt64;
        stop_ns: UInt64;
        is_running: Bool;
    end record;

function NowNs() return UInt64;
procedure Sleep(ms: UInt32);
function NewTimer() return Timer;
procedure StartTimer(mut borrow t: Timer);
function StopTimer(mut borrow t: Timer) return UInt64;
function ElapsedNs(borrow t: Timer) return UInt64;
function ElapsedMs(borrow t: Timer) return UInt64;

implementation

function NowNs() return UInt64 is
begin
    return GetNanoseconds();
end NowNs;

procedure Sleep(ms: UInt32) is
begin
    SleepMs(ms);
end Sleep;

function NewTimer() return Timer is
begin
    return Timer(start_ns: 0, stop_ns: 0, is_running: false);
end NewTimer;

procedure StartTimer(mut borrow t: Timer) is
begin
    t.start_ns := GetNanoseconds();
    t.stop_ns := 0;
    t.is_running := true;
end StartTimer;

function StopTimer(mut borrow t: Timer) return UInt64 is
begin
    t.stop_ns := GetNanoseconds();
    t.is_running := false;
    return t.stop_ns - t.start_ns;
end StopTimer;

function ElapsedNs(borrow t: Timer) return UInt64 is
begin
    if t.is_running then
        return GetNanoseconds() - t.start_ns;
    else
        return t.stop_ns - t.start_ns;
    end if;
end ElapsedNs;

function ElapsedMs(borrow t: Timer) return UInt64 is
begin
    return ElapsedNs(borrow t) / 1000000;
end ElapsedMs;

end Time.
