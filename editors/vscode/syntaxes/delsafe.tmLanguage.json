{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DelSafe",
  "scopeName": "source.dels",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#ownership" },
    { "include": "#keywords" },
    { "include": "#contracts" },
    { "include": "#types" },
    { "include": "#monads" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.dels",
          "match": "//.*$"
        },
        {
          "name": "comment.block.c.dels",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.pascal.dels",
          "begin": "\\{",
          "end": "\\}"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.dels",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.dels",
          "match": "\\\\(n|r|t|\\\\|\"|0)"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.dels",
      "match": "'(\\\\.|[^'])'"
    },
    "ownership": {
      "patterns": [
        {
          "name": "storage.modifier.ownership.dels keyword.other.ownership.dels",
          "match": "\\b(borrow|take|mut)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.module.dels",
          "match": "\\b(module|program|import|as|extern|pascal)\\b"
        },
        {
          "name": "keyword.declaration.type.dels",
          "match": "\\b(type|record|enum|function)\\b"
        },
        {
          "name": "keyword.declaration.variable.dels",
          "match": "\\b(var|let)\\b"
        },
        {
          "name": "keyword.control.block.dels",
          "match": "\\b(begin|end)\\b"
        },
        {
          "name": "keyword.control.flow.dels",
          "match": "\\b(if|then|else|while|do|for|in|match|case|return)\\b"
        },
        {
          "name": "keyword.operator.logical.dels",
          "match": "\\b(and|or|not|mod|implies)\\b"
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "keyword.control.contract.dels",
          "match": "\\b(contract|require|ensure)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.dels",
          "match": "\\b(Int8|Int16|Int32|Int64|UInt8|UInt16|UInt32|UInt64|Float32|Float64|Bool|Char|String|Void)\\b"
        },
        {
          "name": "entity.name.type.dels",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "monads": {
      "patterns": [
        {
          "name": "support.class.monad.dels",
          "match": "\\b(Result|Option)\\b"
        },
        {
          "name": "support.constant.monad-variant.dels",
          "match": "\\b(Ok|Err|Some|None)\\b"
        },
        {
          "name": "support.function.builtin.dels",
          "match": "\\b(PrintLn|WriteLn|Print)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.dels",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.dels",
          "match": "\\b(0x[0-9a-fA-F_]+|\\$[0-9a-fA-F_]+)\\b"
        },
        {
          "name": "constant.numeric.binary.dels",
          "match": "\\b(0b[01_]+|%[01_]+)\\b"
        },
        {
          "name": "constant.numeric.float.dels",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.dels",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.dels",
          "match": ":="
        },
        {
          "name": "keyword.operator.comparison.dels",
          "match": "(<=|>=|<>|<|>|=)"
        },
        {
          "name": "keyword.operator.arithmetic.dels",
          "match": "(\\+|-|\\*|/)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.call.dels",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  }
}
