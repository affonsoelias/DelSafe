{
  "name": "aether-lang",
  "displayName": "Aether Programming Language",
  "description": "Official stable support (v1.0.0) for the Aether language (.aeth): syntax highlighting, canonical formatting (Shift+Alt+F), safe refactoring (F2), Borrow Checker quick-fixes, snippets, and native LSP with instant diagnostics.",
  "version": "1.0.0",
  "publisher": "aether-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "aether",
    "pascal",
    "rust",
    "systems programming",
    "memory safety"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:aether",
    "onCommand:aether.initProject",
    "onCommand:aether.buildProject",
    "onCommand:aether.runProject"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aether",
        "aliases": [
          "Aether",
          "aether"
        ],
        "extensions": [
          ".aeth"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aether",
        "scopeName": "source.aeth",
        "path": "./syntaxes/aether.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aether",
        "path": "./snippets/aether.json"
      }
    ],
    "commands": [
      {
        "command": "aether.initProject",
        "title": "Aether: Initialize New Project (Init / aether.json)",
        "category": "Aether"
      },
      {
        "command": "aether.buildProject",
        "title": "Aether: Build Project (Build)",
        "category": "Aether"
      },
      {
        "command": "aether.runProject",
        "title": "Aether: Run Project (Run)",
        "category": "Aether"
      },
      {
        "command": "aether.compilePascal",
        "title": "Aether: Compile Current File (Pascal Backend)",
        "category": "Aether"
      },
      {
        "command": "aether.compileC",
        "title": "Aether: Compile Current File (C99 / GCC Backend)",
        "category": "Aether"
      },
      {
        "command": "aether.checkDiagnostics",
        "title": "Aether: Analyze and Refresh Diagnostics (AI Mode)",
        "category": "Aether"
      },
      {
        "command": "aether.formatDocument",
        "title": "Aether: Format Document (Shift+Alt+F)",
        "category": "Aether"
      }
    ],
    "problemMatchers": [
      {
        "name": "aetherc",
        "owner": "aether",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^\\[(?:Syntax|Semantic|Ownership) Error(?: (\\w+))? at (\\d+):(\\d+)\\]: (.*)$",
            "code": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        ]
      }
    ]
  }
}
