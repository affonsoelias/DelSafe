{
  "name": "delsafe-lang",
  "displayName": "DelSafe Programming Language",
  "description": "Official stable support (v1.0.0) for the DelSafe language (.dels): syntax highlighting, canonical formatting (Shift+Alt+F), safe refactoring (F2), Borrow Checker quick-fixes, snippets, and native LSP with instant diagnostics.",
  "version": "1.0.0",
  "publisher": "delsafe-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "delsafe",
    "pascal",
    "rust",
    "systems programming",
    "memory safety"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:delsafe",
    "onCommand:delsafe.initProject",
    "onCommand:delsafe.buildProject",
    "onCommand:delsafe.runProject"
  ],
  "contributes": {
    "languages": [
      {
        "id": "delsafe",
        "aliases": [
          "DelSafe",
          "delsafe"
        ],
        "extensions": [
          ".dels"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "delsafe",
        "scopeName": "source.dels",
        "path": "./syntaxes/delsafe.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "delsafe",
        "path": "./snippets/delsafe.json"
      }
    ],
    "commands": [
      {
        "command": "delsafe.initProject",
        "title": "DelSafe: Initialize New Project (Init / delsafe.json)",
        "category": "DelSafe"
      },
      {
        "command": "delsafe.buildProject",
        "title": "DelSafe: Build Project (Build)",
        "category": "DelSafe"
      },
      {
        "command": "delsafe.runProject",
        "title": "DelSafe: Run Project (Run)",
        "category": "DelSafe"
      },
      {
        "command": "delsafe.compilePascal",
        "title": "DelSafe: Compile Current File (Pascal Backend)",
        "category": "DelSafe"
      },
      {
        "command": "delsafe.compileC",
        "title": "DelSafe: Compile Current File (C99 / GCC Backend)",
        "category": "DelSafe"
      },
      {
        "command": "delsafe.checkDiagnostics",
        "title": "DelSafe: Analyze and Refresh Diagnostics (AI Mode)",
        "category": "DelSafe"
      },
      {
        "command": "delsafe.formatDocument",
        "title": "DelSafe: Format Document (Shift+Alt+F)",
        "category": "DelSafe"
      }
    ],
    "problemMatchers": [
      {
        "name": "delsafec",
        "owner": "delsafe",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^\\[(?:Syntax|Semantic|Ownership) Error(?: (\\w+))? at (\\d+):(\\d+)\\]: (.*)$",
            "code": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        ]
      }
    ]
  }
}
