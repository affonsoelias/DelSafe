{
  "name": "aether-lang",
  "displayName": "Aether Programming Language",
  "description": "Suporte oficial e estável (v1.0.0) para a linguagem Aether (.aeth): realce de sintaxe, formatação canônica (Shift+Alt+F), refatoração segura (F2), quick-fix para Borrow Checker, snippets e LSP nativo com diagnóstico instantâneo.",
  "version": "1.0.0",
  "publisher": "aether-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "aether",
    "pascal",
    "rust",
    "systems programming",
    "memory safety"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:aether",
    "onCommand:aether.initProject",
    "onCommand:aether.buildProject",
    "onCommand:aether.runProject"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aether",
        "aliases": [
          "Aether",
          "aether"
        ],
        "extensions": [
          ".aeth"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aether",
        "scopeName": "source.aeth",
        "path": "./syntaxes/aether.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aether",
        "path": "./snippets/aether.json"
      }
    ],
    "commands": [
      {
        "command": "aether.initProject",
        "title": "Aether: Inicializar Novo Projeto (Init / aether.json)",
        "category": "Aether"
      },
      {
        "command": "aether.buildProject",
        "title": "Aether: Compilar Projeto (Build)",
        "category": "Aether"
      },
      {
        "command": "aether.runProject",
        "title": "Aether: Executar Projeto (Run)",
        "category": "Aether"
      },
      {
        "command": "aether.compilePascal",
        "title": "Aether: Compilar Arquivo Atual (Backend Pascal)",
        "category": "Aether"
      },
      {
        "command": "aether.compileC",
        "title": "Aether: Compilar Arquivo Atual (Backend C99 / GCC)",
        "category": "Aether"
      },
      {
        "command": "aether.checkDiagnostics",
        "title": "Aether: Analisar e Atualizar Diagnósticos (Modo IA)",
        "category": "Aether"
      },
      {
        "command": "aether.formatDocument",
        "title": "Aether: Formatar Documento (Shift+Alt+F)",
        "category": "Aether"
      }
    ],
    "problemMatchers": [
      {
        "name": "aetherc",
        "owner": "aether",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^\\[Erro (?:Sintatico|Semantico|de Posse)(?: (\\w+))? em (\\d+):(\\d+)\\]: (.*)$",
            "code": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        ]
      }
    ]
  }
}
