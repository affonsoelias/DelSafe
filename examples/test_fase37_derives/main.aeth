module main;

type
    [derive(Debug, JSON, Clone, Equals)]
    Point = record
        x: Float64;
        y: Float64;
    end record;

    [derive(Debug, JSON, Clone, Equals)]
    User = record
        id: Int32;
        name: String;
        active: Bool;
        position: Point;
    end record;

    [derive(Debug, JSON, Clone, Equals)]
    Status = enum
        Pending,
        Processing,
        Completed
    end enum;

program Main;
var
    p1: Point;
    p2: Point;
    p3: Point;
    u1: User;
    u2: User;
    s1: Status;
    s2: Status;
    debug_p: String;
    json_p: String;
    debug_u: String;
    json_u: String;
    debug_s: String;
    json_s: String;
    is_eq: Bool;
begin
    PrintLn("=== Automatic Derives Test (Phase 37) ===");

    // 1. Simple Record Test (Point)
    p1 := Point(10.5, 20.25);
    debug_p := p1.ToString();
    json_p := p1.ToJSON();
    PrintLn("Point Debug: %s", debug_p);
    PrintLn("Point JSON:  %s", json_p);
    Assert(debug_p = "Point { x: 10.5, y: 20.25 }", "Incorrect Point ToString");
    Assert(json_p = "{\"x\": 10.5, \"y\": 20.25}", "Incorrect Point ToJSON");

    // Clone and Equals Test
    p2 := p1.Clone();
    p3 := Point(99.0, 99.0);
    Assert(p1.Equals(borrow p2), "p1 must equal p2 (clone)");
    Assert(not p1.Equals(borrow p3), "p1 must differ from p3");

    // 2. Nested Record Test (User with Point)
    u1 := User(101, "Alice", true, p1);
    debug_u := u1.ToString();
    json_u := u1.ToJSON();
    PrintLn("User Debug: %s", debug_u);
    PrintLn("User JSON:  %s", json_u);
    Assert(debug_u = "User { id: 101, name: \"Alice\", active: true, position: Point { x: 10.5, y: 20.25 } }", "Incorrect User ToString");
    Assert(json_u = "{\"id\": 101, \"name\": \"Alice\", \"active\": true, \"position\": {\"x\": 10.5, \"y\": 20.25}}", "Incorrect User ToJSON");

    u2 := u1.Clone();
    Assert(u1.Equals(borrow u2), "u1 must equal clone u2");

    // 3. Enum Test (Status)
    s1 := Status.Completed;
    debug_s := s1.ToString();
    json_s := s1.ToJSON();
    PrintLn("Status Debug: %s", debug_s);
    PrintLn("Status JSON:  %s", json_s);
    Assert(debug_s = "Status.Completed", "Incorrect Status ToString");
    Assert(json_s = "\"Completed\"", "Incorrect Status ToJSON");

    s2 := s1.Clone();
    Assert(s1.Equals(borrow s2), "s1 must equal s2");

    PrintLn("All [derive(Debug, JSON, Clone, Equals)] tests passed successfully!");
end main.
