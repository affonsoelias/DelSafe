module InteropExtern;

import pascal Math;

// 1. FFI Explícita (extern c): Necessária para invocar funções C de bibliotecas
// nativas / libc (como puts) nos backends FPC e GCC com checagem rigorosa de tipos.
extern c function puts(s: String): Int32;

// 2. Nota sobre 'sqrt': Funções de módulos padrão (como Math e SysUtils)
// são auto-importadas sem necessidade de 'extern' manual (Zero-Boilerplate).
// Aqui declaramos com 'contract require' para demonstrar contratos em funções FFI:
extern c function sqrt(x: Float64): Float64
contract
    require
        x >= 0.0;
;

program Main;
var
    raiz: Float64;
    res_puts: Int32;
begin
    PrintLn("=== TESTE DE INTEROPERABILIDADE EXTERNA (FFI C & PASCAL) ===");

    // 1. Chamada a funcao C externa: puts() via FFI
    res_puts := puts("Mensagem impressa diretamente pela funcao C: puts()");

    // 2. Chamada a funcao C com contrato e verificacao de pre-condicao
    raiz := sqrt(144.0);
    PrintLn("Raiz quadrada de 144.0 calculada via C sqrt(): " + FloatToStr(raiz));

    raiz := sqrt(49.0);
    PrintLn("Raiz quadrada de 49.0 calculada via C sqrt(): " + FloatToStr(raiz));

    PrintLn("");
    PrintLn("Interoperabilidade C (extern c) e import Pascal funcionando com sucesso!");
end.
