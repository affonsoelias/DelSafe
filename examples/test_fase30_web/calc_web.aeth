module calc_web;

interface

function Somar(a, b: Int32) return Int32;
function Multiplicar(a, b: Int32) return Int32;

implementation

function Somar(a, b: Int32) return Int32 is
begin
    return a + b;
end Somar;

function Multiplicar(a, b: Int32) return Int32 is
begin
    return a * b;
end Multiplicar;

end calc_web.
