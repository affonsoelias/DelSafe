/// Módulo de cálculos geométricos e estatísticos de alta precisão.
/// Fornece estruturas, contratos formais e funções com semântica estrita de posse.
module geometria;

type
    /// Representa um Ponto 2D no plano cartesiano.
    Ponto = record
        /// Coordenada horizontal X.
        x: Float64;
        /// Coordenada vertical Y.
        y: Float64;
    end;

    /// Modo de renderização de formas geométricas.
    ModoRender = enum
        Wireframe,
        Solid,
        Textured
    end;

/// Contrato para formas geométricas com cálculo de área.
trait FormaGeometrica
    function CalcularArea(borrow self: Ponto): Float64;
end;

/// Cria um novo ponto no plano cartesiano.
/// @param x Coordenada X
/// @param y Coordenada Y
/// @return Uma nova instância de Ponto com posse transferida
///
/// ```aether
/// var p: Ponto := CriarPonto(10.0, 20.0);
/// Assert(p.x > 0.0);
/// ```
function CriarPonto(x: Float64, y: Float64): Ponto
require
    x >= 0.0;
    y >= 0.0;
ensure
    x >= 0.0;
var
    res: Ponto;
begin
    res.x := x;
    res.y := y;
    return res;
end;

/// Desloca as coordenadas de um ponto diretamente na memória.
/// @param p Referência mutável do ponto a ser modificado
/// @param dx Deslocamento horizontal
/// @param dy Deslocamento vertical
function DeslocarPonto(mut borrow p: Ponto, dx: Float64, dy: Float64): Void
begin
    p.x := p.x + dx;
    p.y := p.y + dy;
end;

/// Computa a área assíncrona de um retângulo delimitador.
/// @param largura Largura total do retângulo
/// @param altura Altura total do retângulo
/// @return Tarefa contendo a área calculada
async function CalcularAreaAsync(largura: Float64, altura: Float64): Float64
require
    largura > 0.0;
    altura > 0.0;
begin
    return largura * altura;
end;

program test_doc;
var
    p: Ponto;
begin
    p := CriarPonto(5.0, 10.0);
    DeslocarPonto(mut borrow p, 2.0, 3.0);
    PrintLn("Ponto X: " + FloatToStr(p.x));
    PrintLn("Ponto Y: " + FloatToStr(p.y));
end.
