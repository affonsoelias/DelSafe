module OptimizerAndRelease;

function DaysToSeconds(borrow days: Int32) return Int32 is
var
    secondsPerDay: Int32;
    outcome: Int32;
begin
    // Compile-time constant folding: 24 * 60 * 60 -> 86400
    secondsPerDay := 24 * 60 * 60;
    outcome := days * secondsPerDay;
    return outcome;
end DaysToSeconds;

function TestDeadCode() return Int32 is
begin
    return 777;
    // Dead Code Elimination: code after unconditional return is eliminated in AST
    PrintLn("ERROR: Dead code executed!");
end TestDeadCode;

program Main;
var
    days: Int32;
    seconds: Int32;
    x: Int32;
    y: Int32;
    z: Int32;
    statusMsg: String;
    condition: Bool;
    dead_res: Int32;
begin
    PrintLn("=== Aether: AST Optimizations & Release Mode Test ===");

    // 1. Integer and string constant folding
    days := 7;
    seconds := DaysToSeconds(borrow days);
    PrintLn("7 days in seconds (24*60*60):");
    PrintLn(seconds);
    Assert(seconds = 604800, "7 days must total 604800 seconds");

    statusMsg := "Aether " + "Engine " + "Release";
    PrintLn(statusMsg);
    Assert(statusMsg = "Aether Engine Release", "Strings must be concatenated");

    // 2. Algebraic simplifications (x + 0 -> x, y * 1 -> y)
    x := 50;
    y := x + 0;
    z := y * 1;
    PrintLn("Simplified value (x + 0) * 1:");
    PrintLn(z);
    Assert(z = 50, "Algebraic identity simplification must preserve value 50");

    // 3. Boolean constant folding
    condition := (100 > 50) and (20 = 20);
    if condition then
        PrintLn("Condition folded successfully (true)!");
    end if;
    Assert(condition = true, "Boolean condition must fold to true");

    // 4. Dead Code Elimination: if false and while false
    if false then
        PrintLn("ERROR: Dead branch if-false executed!");
        Assert(false, "Dead branch must not execute");
    else
        PrintLn("Else branch of if-false promoted successfully!");
    end if;

    while false do
        PrintLn("ERROR: Dead loop while-false executed!");
        Assert(false, "Dead loop must not execute");
    end while;

    // 5. Function call with return and unreachable code eliminated
    dead_res := TestDeadCode();
    PrintLn("Function with dead code tested, return:");
    PrintLn(dead_res);
    Assert(dead_res = 777, "TestDeadCode return must be 777");

    PrintLn("=== SUCCESS: All AST optimizations validated! ===");
end OptimizerAndRelease.
