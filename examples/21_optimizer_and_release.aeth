module OptimizerAndRelease;

function CalcularDiasEmSegundos(borrow dias: Int32): Int32
var
    segundosPorDia: Int32;
    resultado: Int32;
begin
    // Constant folding em tempo de compilação: 24 * 60 * 60 -> 86400
    segundosPorDia := 24 * 60 * 60;
    resultado := dias * segundosPorDia;
    return resultado;
end;

function TesteDeadCode(): Int32
begin
    return 777;
    // Dead Code Elimination: código após return incondicional é eliminado na AST
    PrintLn("ERRO: Codigo morto executado!");
end;

program Main;
var
    dias: Int32;
    segundos: Int32;
    x: Int32;
    y: Int32;
    z: Int32;
    statusMsg: String;
    condicao: Bool;
    morto: Int32;
begin
    PrintLn("=== Aether: Teste de Otimizacoes de AST & Modo Release ===");

    // 1. Constant folding de inteiros e strings
    dias := 7;
    segundos := CalcularDiasEmSegundos(borrow dias);
    PrintLn("7 dias em segundos (24*60*60):");
    PrintLn(segundos);
    Assert(segundos = 604800, "7 dias devem totalizar 604800 segundos");

    statusMsg := "Aether " + "Engine " + "Release";
    PrintLn(statusMsg);
    Assert(statusMsg = "Aether Engine Release", "Strings devem ser concatenadas");

    // 2. Simplificações algébricas (x + 0 -> x, y * 1 -> y)
    x := 50;
    y := x + 0;
    z := y * 1;
    PrintLn("Valor simplificado (x + 0) * 1:");
    PrintLn(z);
    Assert(z = 50, "Simplificacao de identidades algebricas deve manter valor 50");

    // 3. Constant folding booleano
    condicao := (100 > 50) and (20 = 20);
    if condicao then
        PrintLn("Condicao dobrada com sucesso (true)!");
    end;
    Assert(condicao = true, "Condicao booleana deve ser dobrada para true");

    // 4. Dead Code Elimination: if false e while false
    if false then
        PrintLn("ERRO: Ramo morto if-false executou!");
        Assert(false, "Ramo morto nao deve executar");
    else
        PrintLn("Ramo else de if-false promovido com sucesso!");
    end;

    while false do
        PrintLn("ERRO: Loop morto while-false executou!");
        Assert(false, "Loop morto nao deve executar");
    end;

    // 5. Chamada de função com retorno e código inalcançável eliminado
    morto := TesteDeadCode();
    PrintLn("Funcao com dead code testada, retorno:");
    PrintLn(morto);
    Assert(morto = 777, "Retorno de TesteDeadCode deve ser 777");

    PrintLn("=== SUCESSO: Todas as otimizacoes de AST validadas! ===");
end.
