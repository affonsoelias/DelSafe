module async_demo;

async function ComputeSum(a, b: Int32) return Int32 is
begin
    return a + b;
end ComputeSum;

async function SlowMultiply(x, y: Int32) return Int32 is
begin
    return x * y;
end SlowMultiply;

async function GetMessage(name: String) return String is
begin
    return "Hello async, " + name;
end GetMessage;

program Main;
var
    sum_val: Int32;
    t1: Task<Int32>;
    t2: Task<Int32>;
    res1: Int32;
    res2: Int32;
    msg: String;
begin
    PrintLn("=== DELSAFE CONCURRENCY & ASYNC/AWAIT TEST ===");

    // 1. Direct call with await
    sum_val := await ComputeSum(15, 27);
    PrintLn("1. await ComputeSum(15, 27) =");
    PrintLn(sum_val);
    Assert(sum_val = 42, "Async sum failure!");

    // 2. Concurrent dispatch with spawn and later await
    t1 := spawn SlowMultiply(6, 7);
    t2 := spawn SlowMultiply(10, 5);

    res1 := await t1;
    res2 := await t2;
    PrintLn("2. await t1 (6*7) =");
    PrintLn(res1);
    PrintLn("3. await t2 (10*5) =");
    PrintLn(res2);
    Assert(res1 = 42, "Failure in res1!");
    Assert(res2 = 50, "Failure in res2!");

    // 3. Async string
    msg := await GetMessage("DelSafe");
    PrintLn("4. Async message:");
    PrintLn(msg);

    PrintLn("SUCCESS: All async/await tests passed!");
end async_demo.
