module calc_web;

interface

function Add(a, b: Int32) return Int32;
function Multiply(a, b: Int32) return Int32;

implementation

function Add(a, b: Int32) return Int32 is
begin
    return a + b;
end Add;

function Multiply(a, b: Int32) return Int32 is
begin
    return a * b;
end Multiply;

end calc_web.
