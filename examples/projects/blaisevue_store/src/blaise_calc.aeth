module blaise_calc;

interface

function SomarValores(a, b: Int32) return Int32;
function MultiplicarValores(a, b: Int32) return Int32;

implementation

function SomarValores(a, b: Int32) return Int32 is
begin
    return a + b;
end SomarValores;

function MultiplicarValores(a, b: Int32) return Int32 is
begin
    return a * b;
end MultiplicarValores;

end blaise_calc.
