module main;

import vectors_2d;

program Main;
var
    p1: Point2D;
    p2: Point2D;
    p3: Point2D;
    n: Float64;
begin
    p1 := CreatePoint(3.0, 4.0);
    p2 := CreatePoint(1.0, 2.0);
    p3 := AddPoints(p1, p2);
    n := NormSquared(p1);

    PrintLn("P3 X = %f, Y = %f", p3.x, p3.y);
    PrintLn("Norm p1 = %f", n);
end main.
