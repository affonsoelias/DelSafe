module MathExtra;

interface

function DoubleVal(borrow v: Int32) return Int32;
function TripleVal(borrow v: Int32) return Int32;

implementation

function DoubleVal(borrow v: Int32) return Int32 is
begin
    return v * 2;
end DoubleVal;

function TripleVal(borrow v: Int32) return Int32 is
begin
    return v * 3;
end TripleVal;

end MathExtra.
