module app_profile;

[derive(Debug, JSON, Clone, Equals)]
type
    Item = record
        id: Int32;
        name: String;
        price: Float64;
    end record;

function ProcessList(qty: Int32) return Float64 is
var
    i: Int32;
    total: Float64;
    it: Item;
begin
    total := 0.0;
    i := 0;
    while i < qty do
        it := Item(i, "Product", 10.5);
        total := total + it.price;
        i := i + 1;
    end while;
    return total;
end ProcessList;

program Main;
var
    res: Float64;
begin
    res := ProcessList(1000);
    PrintLn("Processing finished. Total: %f", res);
end app_profile.
