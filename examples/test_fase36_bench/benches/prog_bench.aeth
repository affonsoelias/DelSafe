module prog_bench;

function RunComputation() return Int32 is
var
    i: Int32;
    s: Int32;
begin
    s := 0;
    i := 0;
    while i < 50000 do
        s := s + (i mod 10);
        i := i + 1;
    end while;
    return s;
end RunComputation;

program Main;
var
    res: Int32;
begin
    res := RunComputation();
end prog_bench.
