module math_bench;

interface

function Fibonacci(n: Int32) return Int32;
function SomaIterativa() return Float64;
/// @bench
procedure BenchFibonacci;
/// @bench
procedure BenchSoma;

implementation

function Fibonacci(n: Int32) return Int32 is
var
    a, b, temp, i: Int32;
begin
    if n <= 1 then
        return n;
    end;
    a := 0;
    b := 1;
    i := 2;
    while i <= n do
        temp := a + b;
        a := b;
        b := temp;
        i := i + 1;
    end;
    return b;
end Fibonacci;

function SomaIterativa() return Float64 is
var
    total: Float64;
    i: Int32;
begin
    total := 0.0;
    i := 1;
    while i <= 500 do
        total := total + (Float64(i) * 0.5);
        i := i + 1;
    end;
    return total;
end SomaIterativa;

/// @bench
procedure BenchFibonacci is
var
    res: Int32;
begin
    res := Fibonacci(30);
end BenchFibonacci;

/// @bench
procedure BenchSoma is
var
    s: Float64;
begin
    s := SomaIterativa();
end BenchSoma;

end math_bench.
