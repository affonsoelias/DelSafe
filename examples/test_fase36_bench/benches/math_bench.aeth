module math_bench;

function Fibonacci(n: Int32): Int32;
var
    a: Int32;
    b: Int32;
    temp: Int32;
    i: Int32;
begin
    if n <= 1 then
        return n;
    end;
    a := 0;
    b := 1;
    i := 2;
    while i <= n do
        temp := a + b;
        a := b;
        b := temp;
        i := i + 1;
    end;
    return b;
end;

function SomaIterativa(): Float64;
var
    total: Float64;
    i: Int32;
begin
    total := 0.0;
    i := 1;
    while i <= 500 do
        total := total + (Float64(i) * 0.5);
        i := i + 1;
    end;
    return total;
end;

/// @bench
function BenchFibonacci(): Void;
var
    res: Int32;
begin
    res := Fibonacci(30);
end;

/// @bench
function BenchSoma(): Void;
var
    s: Float64;
begin
    s := SomaIterativa();
end;
