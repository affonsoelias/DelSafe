module dirty_test;

import std.math;
import std.io;

type
    point = record
        x: Float64;
        y: Float64;
    end record;

function Compute(a, b: Int32) return Int32 is
var
    unused_local: Int32;
begin
    if a = true then
        return a;
    end if;

    return a + 10;

    // Dead code after return:
    PrintLn("This will never be executed!");
end Compute;

program Main;
var
    temp: Int32;
    p: point;
begin
    p := point(1.0, 2.0);
    PrintLn("X: %f", p.x);
    PrintLn("Result: %d", Compute(5, 10));
end dirty_test.
