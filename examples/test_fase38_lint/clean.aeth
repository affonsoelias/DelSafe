module clean;

type
    Point = record
        x: Float64;
        y: Float64;
    end record;

function DoubleVal(val: Int32) return Int32 is
begin
    return val * 2;
end DoubleVal;

program Main;
var
    p: Point;
begin
    p := Point(3.5, 7.5);
    PrintLn("Coordinates: %f, %f", p.x, p.y);
    PrintLn("Double: %d", DoubleVal(21));
end clean.
