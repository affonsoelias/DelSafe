module MathExtra;

interface

function Dobro(borrow v: Int32) return Int32;
function Triplo(borrow v: Int32) return Int32;

implementation

function Dobro(borrow v: Int32) return Int32 is
begin
    return v * 2;
end Dobro;

function Triplo(borrow v: Int32) return Int32 is
begin
    return v * 3;
end Triplo;

end MathExtra.
