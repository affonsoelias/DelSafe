module box_and_recursion;

type
    // Recursive binary expression tree node
    ExprNode = record
        kind: UInt32;        // 1 = Literal value, 2 = Addition
        val: Int64;
        left: Option<Box<ExprNode>>;
        right: Option<Box<ExprNode>>;
    end record;

function CreateValue(borrow v: Int64) return ExprNode is
begin
    return ExprNode(
        kind: 1,
        val: v,
        left: None,
        right: None
    );
end CreateValue;

function CreateAdd(take l, r: ExprNode) return ExprNode is
begin
    return ExprNode(
        kind: 2,
        val: 0,
        left: Some(Box(l)),
        right: Some(Box(r))
    );
end CreateAdd;

function Evaluate(borrow node: ExprNode) return Int64 is
var
    left_val: Int64;
    right_val: Int64;
begin
    if node.kind = 1 then
        return node.val;
    else
        left_val := 0;
        right_val := 0;

        if node.left.is_some then
            left_val := Evaluate(borrow node.left.value);
        end if;

        if node.right.is_some then
            right_val := Evaluate(borrow node.right.value);
        end if;

        return left_val + right_val;
    end if;
end Evaluate;

program Main;
var
    n1: ExprNode;
    n2: ExprNode;
    tree: ExprNode;
    outcome: Int64;
begin
    PrintLn("=== RECURSIVE STRUCTURE TEST WITH BOX AND OPTION (PHASE 11) ===");

    n1 := CreateValue(borrow 25);
    n2 := CreateValue(borrow 17);

    // Builds the binary tree combining both nodes on the heap via Box
    tree := CreateAdd(take n1, take n2);

    outcome := Evaluate(borrow tree);
    PrintLn("Expression Tree Evaluation (25 + 17): %d", outcome);

    if outcome = 42 then
        PrintLn("SUCCESS! Recursive tree with Box evaluated properly!");
    else
        PrintLn("FAIL evaluating tree.");
    end if;
end box_and_recursion.
