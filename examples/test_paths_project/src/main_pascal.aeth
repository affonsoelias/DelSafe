module MainPascal;

import arvores.carvalho;
import caverna.dragao;
import pascal "AuxiliarPascal";

extern pascal function TriploPascal(x: Int32) return Int32;

program Main;
var
    my_tree: Tree;
    res_pas: Int32;
begin
    PrintLn("=== Paths, Subfolders, and Pascal Interop Test (Aether / Pascal) ===");

    // 1. Test arvores/ subfolder
    my_tree := CreateOak(20, 80);
    PrintLn("Oak created: height = %d m, age = %d years", my_tree.height, my_tree.age);

    // 2. Test caverna/ subfolder
    Roar();

    // 3. Test Pascal interop (pascal_units via paths / -Fu)
    res_pas := TriploPascal(15);
    PrintLn("TriploPascal(15) returned: %d", res_pas);

    PrintLn("=== SUCCESS: Pascal backend and external units operational! ===");
end MainPascal.
