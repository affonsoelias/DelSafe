module MainPascal;

import arvores.carvalho;
import caverna.dragao;
import pascal "AuxiliarPascal";

extern pascal function TriploPascal(x: Int32): Int32;

program Main;
var
    minha_arvore: Arvore;
    res_pas: Int32;
begin
    PrintLn("=== Teste de Paths, Subpastas e Interop Pascal (Aether / Pascal) ===");
    
    // 1. Testa subpasta arvores/
    minha_arvore := CriarCarvalho(20, 80);
    PrintLn("Carvalho criado: altura = %d m, idade = %d anos", minha_arvore.altura, minha_arvore.idade);

    // 2. Testa subpasta caverna/
    Rugir();

    // 3. Testa interop Pascal (pascal_units via paths / -Fu)
    res_pas := TriploPascal(15);
    PrintLn("TriploPascal(15) retornou: %d", res_pas);

    PrintLn("=== SUCESSO: Backend Pascal e units externas operacionais! ===");
end.
