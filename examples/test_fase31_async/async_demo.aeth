module async_demo;

async function CalcularSoma(a: Int32, b: Int32): Int32
begin
    return a + b;
end;

async function MultiplicarLento(x: Int32, y: Int32): Int32
begin
    return x * y;
end;

async function ObterMensagem(nome: String): String
begin
    return "Ola assincrono, " + nome;
end;

program Main;
var
    soma: Int32;
    t1: Task<Int32>;
    t2: Task<Int32>;
    res1: Int32;
    res2: Int32;
    msg: String;
begin
    PrintLn("=== TESTE CONCORRENCIA & ASYNC/AWAIT AETHER ===");

    // 1. Chamada direta com await
    soma := await CalcularSoma(15, 27);
    PrintLn("1. await CalcularSoma(15, 27) =");
    PrintLn(soma);
    Assert(soma = 42, "Falha na soma assincrona!");

    // 2. Disparo concorrente com spawn e await posterior
    t1 := spawn MultiplicarLento(6, 7);
    t2 := spawn MultiplicarLento(10, 5);

    res1 := await t1;
    res2 := await t2;
    PrintLn("2. await t1 (6*7) =");
    PrintLn(res1);
    PrintLn("3. await t2 (10*5) =");
    PrintLn(res2);
    Assert(res1 = 42, "Falha no res1!");
    Assert(res2 = 50, "Falha no res2!");

    // 3. String assincrona
    msg := await ObterMensagem("Aether");
    PrintLn("4. Mensagem assincrona:");
    PrintLn(msg);

    PrintLn("SUCESSO: Todos os testes de async/await passaram com perfeicao!");
end.
