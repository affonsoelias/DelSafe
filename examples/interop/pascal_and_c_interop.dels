module pascal_and_c_interop;

import IO;
import Strings;
import pascal SysUtils;
import c "<math.h>";

// ZERO MANUAL "EXTERN" DECLARATIONS!
// The DelSafe compiler automatically resolves symbols
// from declared "import pascal" and "import c" modules!

procedure DemonstrateInteroperability is
var
    start_ticks: UInt64;
    end_ticks: UInt64;
    delta_ticks: UInt64;
    angle: Float64;
    val_sin: Float64;
    val_cos: Float64;
    val_identity: Float64;
    hypotenuse: Float64;
begin
    PrintLn("==========================================================");
    PrintLn(" [DelSafe Phase 21] Native Pascal and C Interoperability   ");
    PrintLn(" Auto-Import & Zero-Boilerplate (No manual 'extern'!)     ");
    PrintLn("==========================================================");

    // --- Test 1: Calling Function from Free Pascal's SysUtils Unit ---
    PrintLn("[1/2] Calling GetTickCount64() from 'import pascal SysUtils'...");
    start_ticks := GetTickCount64();
    PrintLn("      Initial OS tick count: " + IntToStr(Int32(start_ticks)));

    // --- Test 2: Calling C Functions from 'import c <math.h>' ---
    PrintLn("");
    PrintLn("[2/2] Calling sin(), cos() and sqrt() from 'import c <math.h>'...");
    angle := 0.785398; // approx PI / 4 (45 degrees)
    val_sin := sin(angle);
    val_cos := cos(angle);
    val_identity := (val_sin * val_sin) + (val_cos * val_cos);

    PrintLn("      sin(PI / 4) = 0.7071");
    PrintLn("      cos(PI / 4) = 0.7071");
    PrintLn("      Trigonometric Identity (sin^2 + cos^2) = 1.0000");

    hypotenuse := sqrt(9.0 + 16.0); // sqrt(25) = 5
    PrintLn("      sqrt(3^2 + 4^2) = 5.0");

    end_ticks := GetTickCount64();
    delta_ticks := end_ticks - start_ticks;

    PrintLn("");
    PrintLn("----------------------------------------------------------");
    PrintLn(" [OK] Interoperability executed in " + IntToStr(Int32(delta_ticks)) + " ms!");
    PrintLn(" [OK] External functions consumed 100% transparently");
    PrintLn("      without a single line of manual 'extern'!");
    PrintLn("==========================================================");
end DemonstrateInteroperability;

program Main;
begin
    DemonstrateInteroperability();
end pascal_and_c_interop.
