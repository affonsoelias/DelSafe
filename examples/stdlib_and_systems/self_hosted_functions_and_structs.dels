module self_hosted_functions_and_structs;

type
    Point = record
        x: Int32;
        y: Int32;
    end record;

function DoubleVal(val: Int32) return Int32 is
begin
    return val * 2;
end DoubleVal;

function AddVals(a, b: Int32) return Int32 is
begin
    return a + b;
end AddVals;

program Main;
var
    n1: Int32;
    n2: Int32;
    result_val: Int32;
begin
    PrintLn("--- Phase 23 Demonstration: Self-Hosted Functions and Structs ---");
    n1 := 15;
    n2 := 25;
    result_val := AddVals(n1, n2);
    PrintLn("Sum result of 15 and 25:");
    if result_val = 40 then
        PrintLn("Sum computed successfully: 40!");
    end if;
    result_val := DoubleVal(result_val);
    PrintLn("Double of result computed successfully!");
    PrintLn("--- End of Execution! ---");
end self_hosted_functions_and_structs.
