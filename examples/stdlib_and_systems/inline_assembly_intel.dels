module inline_assembly_intel;

program Main;
var
    message: String;
begin
    PrintLn("========================================================");
    PrintLn("  DelSafe - Inline Assembly Demonstration (Intel Syntax) ");
    PrintLn("========================================================");

    PrintLn("[1/3] Executing CPU control instructions (NOP)...");
    asm
        nop
        nop
        nop
    end asm;
    PrintLn("      3 NOPs executed directly by the processor!");

    PrintLn("[2/3] Executing RDTSC (Reading CPU Clock Cycles)...");
    asm
        rdtsc
    end asm;
    PrintLn("      RDTSC instruction executed successfully!");

    PrintLn("[3/3] Register operations in Intel Syntax...");
    asm
        mov eax, 42
        add eax, 8
    end asm;
    PrintLn("      Registers manipulated directly using Intel syntax!");

    PrintLn("");
    PrintLn("SUCCESS: Native Intel Assembly code executed!");
end inline_assembly_intel.
