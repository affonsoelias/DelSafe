module standard_library_basics;

import Math;
import Strings;
import IO;
import Collections;

program Main;
var
    val_abs: Float64;
    val_max: Float64;
    val_clamped: Float64;
    val_pow: Float64;
    res_sqrt: Result<Float64, MathError>;
    buffer: FixedBuffer;
    ok_push: Bool;
begin
    PrintLn("=== AETHER STANDARD LIBRARY TEST (STD/) ===");

    // 1. Testing std/io
    LogInfo(borrow "Initializing standard library demonstration...");

    // 2. Testing std/strings
    PrintMessage(borrow "INFO", borrow "Strings module loaded successfully!");
    if IsEmpty(borrow "") then
        PrintLn("Strings validation: IsEmpty(\"\") returned true as expected.");
    end if;

    // 3. Testing std/math
    val_abs := Abs(borrow -42.5);
    val_max := Max(borrow 10.0, borrow 99.5);
    val_clamped := Clamp(borrow 150.0, borrow 0.0, 100.0);
    val_pow := Pow(borrow 2.0, borrow 8.0);

    PrintLn("Math.Abs(-42.5) = %f", val_abs);
    PrintLn("Math.Max(10.0, 99.5) = %f", val_max);
    PrintLn("Math.Clamp(150.0, 0.0, 100.0) = %f", val_clamped);
    PrintLn("Math.Pow(2.0, 8.0) = %f", val_pow);

    res_sqrt := SqrtSafe(borrow 81.0);
    match res_sqrt do
        case Ok(let root_val):
            PrintLn("Math.SqrtSafe(81.0) = %f", root_val);
        case Err(MathError.InvalidDomain):
            PrintLn("Error: Square root of a negative number!");
        case Err(MathError.DivisionByZero):
            PrintLn("Error: Division by zero!");
    end match;

    // 4. Testing std/collections with UFCS syntax and ownership control
    PrintLn("\n--- Testing std/collections (FixedBuffer) ---");
    buffer := NewBuffer(borrow 3);
    PrintLn("Buffer created with capacity: %d, items: %d", buffer.capacity, buffer.count);

    ok_push := buffer.PushItem();
    ok_push := buffer.PushItem();
    PrintLn("After 2 PushItem calls: items = %d, available = %d", buffer.count, buffer.Available());

    if not buffer.IsFull() then
        PrintLn("Buffer still has space!");
    end if;

    ok_push := buffer.PushItem();
    if buffer.IsFull() then
        PrintLn("Buffer is now completely full (capacity exhausted)!");
    end if;

    PrintLn("\nAll 4 std/ modules operating successfully!");
end standard_library_basics.
