module self_hosted_compiler_demo;

program Main;
var
    x: Int32;
    counter: Int32;
begin
    x := 10;
    counter := 0;
    PrintLn("Starting self-hosted compiler test");
    if x = 10 then
        PrintLn("Conditional x = 10 evaluated successfully!");
    end if;
    while counter < 3 do
        PrintLn("While loop iteration");
        counter := counter + 1;
    end while;
    PrintLn("End of test!");
end self_hosted_compiler_demo.
