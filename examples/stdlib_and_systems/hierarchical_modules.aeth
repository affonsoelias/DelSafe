module hierarchical_modules;

import Compiler.Aeth.Tokens;

program Main;
var
    tok: Token;
begin
    PrintLn("=== HIERARCHICAL NAMESPACES TEST (PHASE 13) ===");
    tok := NewToken(TokenKind.tkProgram, "program", 1, 1);
    PrintLn("Token created via hierarchical import Compiler.Aeth.Tokens:");
    PrintLn("  Text: %s", tok.text);
    PrintLn("  Kind: %s", TokenKindToString(borrow tok.kind));
    PrintLn("SUCCESS! Module imported via dotted namespace!");
end hierarchical_modules.
