module StdIoAndCollections;

import IO;
import Strings;
import Collections;

program Main;
var
    sb: StringBuilder;
    final_str: String;
    file_path: String;
    read_content: String;
    write_ok: Bool;
    exists_flag: Bool;
    str_len: UInt32;
    first_char: String;
    slice_str: String;
begin
    PrintLn("=== STD I/O, STRINGS AND COLLECTIONS TEST (PHASE 11) ===");

    // 1. StringBuilder test
    sb := NewStringBuilder();
    sb.Append(borrow "Aether ");
    sb.Append(borrow "Self-Hosting ");
    sb.Append(borrow "Ready!");

    final_str := sb.ToString();
    PrintLn("Text built by StringBuilder: \"%s\"", final_str);
    PrintLn("Length tracked by StringBuilder: %d", sb.length);

    // 2. String operations test
    str_len := Length(borrow final_str);
    PrintLn("Length measured via Length(): %d", str_len);

    first_char := CharAt(borrow final_str, 0);
    PrintLn("First character via CharAt(0): \"%s\"", first_char);

    slice_str := Substring(borrow final_str, 7, 12);
    PrintLn("Slice via Substring(7, 12): \"%s\"", slice_str);

    // 3. File I/O test
    file_path := "bin/test_phase11.txt";
    PrintLn("\nWriting file \"%s\"...", file_path);
    write_ok := WriteFile(borrow file_path, borrow final_str);

    if write_ok then
        PrintLn("[PASS] File written successfully!");
    else
        PrintLn("[FAIL] Failed to write file.");
    end if;

    exists_flag := FileExists(borrow file_path);
    if exists_flag then
        PrintLn("[PASS] FileExists() confirmed the file exists!");
    else
        PrintLn("[FAIL] FileExists() reported the file does not exist.");
    end if;

    read_content := ReadFile(borrow file_path);
    PrintLn("Content read from file:\n--> %s", read_content);

    PrintLn("\nSUCCESS! Phase 11 - I/O, Strings and Collections validated successfully!");
end StdIoAndCollections.
