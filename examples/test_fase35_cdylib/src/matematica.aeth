module matematica;

interface

type
    Ponto2D = record
        x: Float64;
        y: Float64;
    end;

/// Cria e inicializa uma coordenada 2D
export cdecl function CriarPonto(x, y: Float64) return Ponto2D;
/// Soma dois pontos 2D
export cdecl function SomarPontos(p1, p2: Ponto2D) return Ponto2D;
/// Retorna a norma euclidiana ao quadrado de um ponto
export cdecl function NormaAoQuadrado(p: Ponto2D) return Float64;
/// Funcao simples para somar dois inteiros de 32 bits
export cdecl function SomarInteiros(a, b: Int32) return Int32;
/// Multiplica dois inteiros de 32 bits
export cdecl function MultiplicarInteiros(a, b: Int32) return Int32;

implementation

export cdecl function CriarPonto(x, y: Float64) return Ponto2D is
begin
    return Ponto2D(x: x, y: y);
end CriarPonto;

export cdecl function SomarPontos(p1, p2: Ponto2D) return Ponto2D is
begin
    return Ponto2D(x: p1.x + p2.x, y: p1.y + p2.y);
end SomarPontos;

export cdecl function NormaAoQuadrado(p: Ponto2D) return Float64 is
begin
    return (p.x * p.x) + (p.y * p.y);
end NormaAoQuadrado;

export cdecl function SomarInteiros(a, b: Int32) return Int32 is
begin
    return a + b;
end SomarInteiros;

export cdecl function MultiplicarInteiros(a, b: Int32) return Int32 is
begin
    return a * b;
end MultiplicarInteiros;

end matematica.
