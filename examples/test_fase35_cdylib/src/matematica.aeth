module matematica;

interface

type
    Point2D = record
        x: Float64;
        y: Float64;
    end record;

/// Creates and initializes a 2D coordinate
export cdecl function CreatePoint(x, y: Float64) return Point2D;
/// Adds two 2D points
export cdecl function AddPoints(p1, p2: Point2D) return Point2D;
/// Returns the squared Euclidean norm of a point
export cdecl function NormSquared(p: Point2D) return Float64;
/// Simple function to add two 32-bit integers
export cdecl function AddIntegers(a, b: Int32) return Int32;
/// Multiplies two 32-bit integers
export cdecl function MultiplyIntegers(a, b: Int32) return Int32;

implementation

export cdecl function CreatePoint(x, y: Float64) return Point2D is
begin
    return Point2D(x: x, y: y);
end CreatePoint;

export cdecl function AddPoints(p1, p2: Point2D) return Point2D is
begin
    return Point2D(x: p1.x + p2.x, y: p1.y + p2.y);
end AddPoints;

export cdecl function NormSquared(p: Point2D) return Float64 is
begin
    return (p.x * p.x) + (p.y * p.y);
end NormSquared;

export cdecl function AddIntegers(a, b: Int32) return Int32 is
begin
    return a + b;
end AddIntegers;

export cdecl function MultiplyIntegers(a, b: Int32) return Int32 is
begin
    return a * b;
end MultiplyIntegers;

end matematica.
