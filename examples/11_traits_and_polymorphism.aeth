module TraitsAndPolymorphism;

// Trait definition for text representation
trait Printable
    function ToString(borrow self) return String;
end trait;

// Trait definition for geometric calculations
trait Shape
    function Area(borrow self) return Int32;
    function Perimeter(borrow self) return Int32;
end trait;

type
    Circle = record
        radius: Int32;
    end record;

    Rectangle = record
        width: Int32;
        height: Int32;
    end record;

// Printable trait implementation for Circle
impl Printable for Circle
    function ToString(borrow self) return String is
    begin
        return "Geometric Circle";
    end ToString;
end impl;

// Shape trait implementation for Circle
impl Shape for Circle
    function Area(borrow self) return Int32 is
    begin
        // Approximate Pi = 3 for exact integer calculation
        return 3 * self.radius * self.radius;
    end Area;

    function Perimeter(borrow self) return Int32 is
    begin
        return 2 * 3 * self.radius;
    end Perimeter;
end impl;

// Printable trait implementation for Rectangle
impl Printable for Rectangle
    function ToString(borrow self) return String is
    begin
        return "Geometric Rectangle";
    end ToString;
end impl;

// Shape trait implementation for Rectangle
impl Shape for Rectangle
    function Area(borrow self) return Int32 is
    begin
        return self.width * self.height;
    end Area;

    function Perimeter(borrow self) return Int32 is
    begin
        return 2 * (self.width + self.height);
    end Perimeter;
end impl;

// Static Polymorphic Function with Trait Bound (Zero-Cost Abstraction)
procedure DisplayElement<T: Printable>(borrow item: T) is
begin
    PrintLn("Displaying element via Static Polymorphism: %s", item.ToString());
end DisplayElement;

program Main;
var
    c: Circle;
    r: Rectangle;
    area_c: Int32;
    perim_c: Int32;
    area_r: Int32;
    perim_r: Int32;
begin
    PrintLn("=== TRAITS AND STATIC POLYMORPHISM TEST (PHASE 14) ===");

    c := Circle(radius: 5);
    r := Rectangle(width: 10, height: 4);

    // 1. Direct Static Dispatch via Method-Style Call (UFCS)
    PrintLn("\n1. Static Method Dispatch (Traits):");
    PrintLn("Circle identification: %s", c.ToString());
    PrintLn("Rectangle identification: %s", r.ToString());

    area_c := c.Area();
    perim_c := c.Perimeter();
    PrintLn("Circle (radius = 5) -> Approximate area: %d, Perimeter: %d", area_c, perim_c);

    area_r := r.Area();
    perim_r := r.Perimeter();
    PrintLn("Rectangle (10x4) -> Area: %d, Perimeter: %d", area_r, perim_r);

    // 2. Static Polymorphism with Trait Bounds and Zero-Cost Monomorphization
    PrintLn("\n2. Static Polymorphism with Trait Bound <T: Printable>:");
    DisplayElement(c);
    DisplayElement(r);

    PrintLn("\n[PASS] All type contracts and static dispatches executed successfully!");
end TraitsAndPolymorphism.
