module MethodSyntaxUFCS;

type
    DataBuffer = record
        id: UInt32;
        size: UInt64;
    end;

function Inspecionar(borrow buf: DataBuffer): Void
begin
    PrintLn("Inspecionando buffer via chamada estilo metodo: id = %d, size = %d", buf.id, buf.size);
end;

program Main;
var
    meu_buffer: DataBuffer;
begin
    meu_buffer := DataBuffer(id: 777, size: 8192);

    // Chamada estilo metodo (UFCS)!
    meu_buffer.Inspecionar();
end.
