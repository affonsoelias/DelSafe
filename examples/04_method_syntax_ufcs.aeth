module MethodSyntaxUFCS;

type
    DataBuffer = record
        id: UInt32;
        size: UInt64;
    end record;

procedure Inspect(borrow buf: DataBuffer) is
begin
    PrintLn("Inspecting buffer via method-style call: id = %d, size = %d", buf.id, buf.size);
end Inspect;

program Main;
var
    my_buffer: DataBuffer;
begin
    my_buffer := DataBuffer(id: 777, size: 8192);

    // Method-style call (UFCS)!
    my_buffer.Inspect();
end MethodSyntaxUFCS.
