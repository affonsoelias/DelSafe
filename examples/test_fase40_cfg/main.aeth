module main;

@cfg(target_os = "windows")
function get_platform() return String is
begin
  return "Platform: Windows";
end get_platform;

@cfg(target_os = "linux")
function get_platform() return String is
begin
  return "Platform: Linux";
end get_platform;

@inline(always)
function fast_add(a, b: Int32) return Int32 is
begin
  return a + b;
end fast_add;

@cold
function handle_rare_case() return String is
begin
  return "Rare case executed";
end handle_rare_case;

@cfg(target_os = "windows")
type
  SystemInfo = record
    os_name: String;
    is_windows: Bool;
  end record;

@cfg(target_os = "linux")
type
  SystemInfo = record
    os_name: String;
    is_linux: Bool;
  end record;

program Main;
var
  info: SystemInfo;
  sum: Int32;
  msg: String;
begin
  msg := get_platform();
  PrintLn(msg);

  sum := fast_add(10, 20);
  PrintLn(IntToStr(sum));

  info.os_name := "Windows 64-bit";
  info.is_windows := true;
  if info.is_windows then
    PrintLn("Info: Windows detected successfully!");
  end if;

  PrintLn("Phase 40 CFG and Inline tested successfully!");
end main.
