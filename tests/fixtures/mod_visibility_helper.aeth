module mod_visibility_helper;

interface

const
    PUBLIC_FACTOR = 3;

type
    Level = enum
        Low,
        Medium,
        High
    end enum;

type
    [derive(Debug, JSON, Clone, Equals)]
    BoxItem = record
        pub title: String;
        priv secret: Int32;
    end record;

function ScaleVal(n: Int32) return Int32;

implementation

const
    SECRET_SALT = 999;

impl BoxItem
    pub function Create(lbl: String; sec: Int32) return Self is
    begin
        return BoxItem(lbl, sec);
    end Create;

    pub function ReadSecret(borrow self) return Int32 is
    begin
        return self.secret;
    end ReadSecret;
end impl;

function InternalHelper(n: Int32) return Int32 is
begin
    return n + SECRET_SALT;
end InternalHelper;

function ScaleVal(n: Int32) return Int32 is
begin
    return (n * PUBLIC_FACTOR) + InternalHelper(0) - SECRET_SALT;
end ScaleVal;

end mod_visibility_helper.
