module Fase51TryopMatchexprInlinevarDivcompMaplitTest;

function ParsePositive(n: Int32): Result<Int32, String>
begin
    if n <= 0 then
        return Err("non-positive");
    end;
    return Ok(n);
end;

function SumPositivesWithTry(a: Int32, b: Int32): Result<Int32, String>
begin
    let va := ParsePositive(a)?;
    let vb := try ParsePositive(b);
    return Ok(va + vb);
end;

function FindEven(n: Int32): Option<Int32>
begin
    if (n mod 2) = 0 then
        return Some(n);
    end;
    return None;
end;

function SumEvensWithTry(a: Int32, b: Int32): Option<Int32>
begin
    let ea := FindEven(a)?;
    let eb := try FindEven(b);
    return Some(ea + eb);
end;

function ClassifyCode(code: Int32): String
begin
    let statusLabel := match code do
        case 200, 201 => "OK";
        case let c if c >= 500 => "SERVER_ERR";
        case let c when c >= 400 => "CLIENT_ERR";
        case _ => "OTHER";
    end;
    return statusLabel;
end;

function ScoreResultExpr(res: Result<Int32, String>): Int32
begin
    return match res do
        case Ok(let v) if v > 50 => v * 2;
        case Ok(let v) => v + 1;
        case Err(let _msg) => -1;
    end;
end;

program Main;
var
    resOk, resErr: Result<Int32, String>;
    optSome, optNone: Option<Int32>;
begin
    // 1. Operador de propagacao rapida ? e try expr
    resOk := SumPositivesWithTry(10, 25);
    Assert(resOk.is_ok);
    Assert(resOk.value = 35);

    resErr := SumPositivesWithTry(10, -3);
    Assert(resErr.is_err);
    Assert(resErr.error = "non-positive");

    optSome := SumEvensWithTry(4, 8);
    Assert(optSome.is_some);
    Assert(optSome.value = 12);

    optNone := SumEvensWithTry(4, 7);
    Assert(optNone.is_none);

    // 2. match como expressao & Pattern Guards (if / when)
    Assert(ClassifyCode(200) = "OK");
    Assert(ClassifyCode(201) = "OK");
    Assert(ClassifyCode(503) = "SERVER_ERR");
    Assert(ClassifyCode(404) = "CLIENT_ERR");
    Assert(ClassifyCode(302) = "OTHER");

    Assert(ScoreResultExpr(Ok(80)) = 160);
    Assert(ScoreResultExpr(Ok(20)) = 21);
    Assert(ScoreResultExpr(Err("boom")) = -1);

    var stmtGuardOut: Int32 := 0;
    match Ok(60) do
        case Ok(let v) if v > 50 =>
            stmtGuardOut := v + 100;
        case Ok(let v) =>
            stmtGuardOut := v;
        case Err(let _err) =>
            stmtGuardOut := -1;
    end;
    Assert(stmtGuardOut = 160);

    // 3. Declaracoes var/let inline dentro de begin..end e blocos aninhados
    var mutVal: Int32 := 10;
    let immutVal := 25;
    if mutVal < immutVal then
        let insideIf := mutVal + immutVal;
        Assert(insideIf = 35);
        mutVal += insideIf;
    end;
    Assert(mutVal = 45);

    var loopSum: Int32 := 0;
    for i := 1 to 3 do
        let doubled := i * 2;
        loopSum += doubled;
    end;
    Assert(loopSum = 12);

    // 4. Operadores div, /=, mod=, %=, &=, |=, ^=, <<= e >>=
    let q := 29 div 5;
    Assert(q = 5);

    var calc: Int32 := 100;
    calc /= 4;
    Assert(calc = 25);
    calc mod= 7;
    Assert(calc = 4);
    calc := 29;
    calc %= 6;
    Assert(calc = 5);

    var flt: Float64 := 15.0;
    flt /= 2.0;
    Assert((flt > 7.4) and (flt < 7.6));

    var flags: Int32 := %1010;
    flags |= %0101;
    Assert(flags = 15);
    flags &= %1100;
    Assert(flags = 12);
    flags ^= %1001;
    Assert(flags = 5);
    flags <<= 2;
    Assert(flags = 20);
    flags >>= 1;
    Assert(flags = 10);

    // 5. Literais de Mapa (["a": 1, "b": 2], [:]) & Escapes Completos de Char/String
    var scores := ["alice": 100, "bob": 85];
    Assert(scores.Contains("alice"));
    Assert(scores["bob"] = 85);
    scores["carol"] := 92;
    Assert(scores.Length() = 3);

    var emptyMap: map[String]Int32 := [:];
    Assert(emptyMap.Length() = 0);

    let directScore := ["x": 42, "y": 99]["y"];
    Assert(directScore = 99);

    let cNl := '\n';
    let cTab := '\t';
    let cNul := '\0';
    let cRet := '\r';
    let cSlash := '\\';
    let cQuote := '\'';
    let cDQuote := '\"';
    Assert(Ord(cNl) = 10);
    Assert(Ord(cTab) = 9);
    Assert(Ord(cNul) = 0);
    Assert(Ord(cRet) = 13);
    Assert(Ord(cSlash) = 92);
    Assert(Ord(cQuote) = 39);
    Assert(Ord(cDQuote) = 34);

    let escStr := "a\nb\tc\"d\\e";
    Assert(escStr.Length() = 9);

    PrintLn("=== FASE 51 TEST PASSOU (TRY/?, MATCH EXPR/GUARDS, INLINE VAR/LET, DIV/COMPOSTOS, MAPLIT/ESCAPES) ===");
end.
