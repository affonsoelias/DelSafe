module literals_casts_option_alias_test;

type
    UserId = Int64;
    ByteVal = UInt8;
    IntPtr = ^Int32;
    StatusFlag = (Idle, Running, Done);
    Point = record
        x: Int32;
        y: Int32;
    end record;
    Vec3 = array[3] of Int32;
    ScoreMap = map[String]Int32;

function FindPositive(n: Int32) return Option<Int32> is
begin
    if n > 0 then
        return Some(n * 10);
    end if;
    return None;
end FindPositive;

function FindLabel(flag: Bool) return Option<String> is
begin
    if flag then
        return Some("OkTag");
    end if;
    return None;
end FindLabel;

function ParsePort(p: Int32) return Result<Int32, String> is
begin
    if (p > 0) and (p <= 65535) then
        return Ok(p);
    end if;
    return Err("invalid port");
end ParsePort;

function MakeTextResult(ok: Bool) return Result<String, Int32> is
begin
    if ok then
        return Ok("DelSafe");
    end if;
    return Err(503);
end MakeTextResult;

program Main;
var
    uid: UserId;
    rawByte: ByteVal;
    pRaw: IntPtr;
    targetVal: Int32;
    pt: Point;
    nums := [10, 20, 30];
    words := ["Alpha", "Beta"];
    fixed: Vec3 := [1, 2, 3];
    lastNum, poppedWordCheck, totalSum, keyCount, acc, cnt, szInt64, szPoint: Int32;
    poppedWord: String;
    scores: ScoreMap;
    txt := "DelSafe";
    optInt, optNone: Option<Int32>;
    optStr, optStrNone: Option<String>;
    optSum, errCount: Int32;
    resOk, resErr: Result<Int32, String>;
    resStr: Result<String, Int32>;
    boxOpt: Option<Box<Point>>;
begin
    // 1. Simple Type Aliases and Casts / SizeOf / Ord / Chr / String[i]
    uid := UserId(123456);
    rawByte := ByteVal(250);
    Assert(uid = 123456);
    Assert(rawByte = 250);
    Assert(Int32(3.9) = 3);
    Assert(Int64(uid) = 123456);
    Assert(Ord('A') = 65);
    Assert(Chr(66) = 'B');
    Assert(Ord(StatusFlag.Running) = 1);
    szInt64 := SizeOf(Int64);
    szPoint := SizeOf(Point);
    Assert(szInt64 = 8);
    Assert(szPoint >= 8);
    Assert(txt[0] = 'D');
    Assert(txt[5] = 'f');

    // Pointer via Type Alias + unsafe
    targetVal := 77;
    pRaw := @targetVal;
    unsafe
        pRaw^ := 88;
    end unsafe;
    Assert(targetVal = 88);

    // 2. Array Literals ([...]), Pop and Clear
    Assert(nums.Length() = 3);
    Assert(nums[0] = 10);
    Assert(nums[2] = 30);
    lastNum := nums.Pop();
    Assert(lastNum = 30);
    Assert(nums.Length() = 2);
    nums.Clear();
    Assert(nums.Length() = 0);

    poppedWord := words.Pop();
    poppedWordCheck := 0;
    if poppedWord = "Beta" then
        poppedWordCheck := 1;
    end if;
    Assert(poppedWordCheck = 1);
    words.Clear();
    Assert(words.Length() = 0);

    Assert(fixed[0] = 1);
    Assert(fixed[2] = 3);
    fixed := [7, 8, 9];
    Assert(fixed[0] = 7);
    Assert(fixed[2] = 9);

    // 3. Compound Assignment (+=, -=, *=) and Inc/Dec
    acc := 10;
    acc += 5;
    acc -= 3;
    acc *= 4;
    Assert(acc = 48);

    pt := Point(10, 4);
    pt.x += 5;
    pt.y *= 3;
    Assert(pt.x = 15);
    Assert(pt.y = 12);

    fixed[1] += 10;
    Assert(fixed[1] = 18);

    cnt := 0;
    Inc(cnt);
    Inc(cnt, 9);
    Dec(cnt);
    Dec(cnt, 2);
    Assert(cnt = 7);

    // 4. Map Iteration (for k in map / for k, v in map) + Clear + += on maps
    scores["Alice"] := 10;
    scores["Bob"] := 20;
    scores["Alice"] += 5;
    Assert(scores["Alice"] = 15);

    keyCount := 0;
    for kOnly in scores do
        if kOnly <> "" then
            Inc(keyCount);
        end if;
    end for;
    Assert(keyCount = 2);

    totalSum := 0;
    for kName, vScore in scores do
        if kName <> "" then
            totalSum += vScore;
        end if;
    end for;
    Assert(totalSum = 35);

    scores.Clear();
    Assert(scores.Count() = 0);

    // 5. Option<T> by value and Option<Box<T>> + typed Result<T, E>
    optInt := FindPositive(5);
    optNone := FindPositive(0);
    Assert(optInt.is_some);
    Assert(not optInt.is_none);
    Assert(optInt.value = 50);
    Assert(optNone.is_none);
    Assert(not optNone.is_some);

    optSum := 0;
    match optInt with
        case Some(let x):
            optSum += x;
        case None:
            optSum -= 1;
    end match;
    match optNone with
        case Some(let z):
            optSum += z;
        case None:
            optSum += 5;
    end match;
    Assert(optSum = 55);

    optStr := FindLabel(true);
    optStrNone := FindLabel(false);
    Assert(optStr.is_some);
    Assert(optStr.value = "OkTag");
    Assert(optStrNone.is_none);

    boxOpt := Some(Box(Point(3, 4)));
    Assert(boxOpt.is_some);
    Assert(boxOpt.value.x = 3);

    resOk := ParsePort(8080);
    resErr := ParsePort(-5);
    errCount := 0;
    match resOk with
        case Ok(let p):
            errCount += p;
        case Err(let errMsg):
            if errMsg <> "" then
                Inc(errCount);
            end if;
    end match;
    match resErr with
        case Ok(let pIgnore):
            errCount += pIgnore;
        case Err(let msg):
            if msg = "invalid port" then
                errCount += 100;
            end if;
    end match;
    Assert(errCount = 8180);

    resStr := MakeTextResult(true);
    Assert(resStr.is_ok);
    Assert(resStr.value = "DelSafe");

    PrintLn("=== PHASE 47 TEST PASSED (ARRLIT, MAPFOR, CASTS, COMPASS, REAL OPTION/RESULT, ALIAS) ===");
end literals_casts_option_alias_test.
