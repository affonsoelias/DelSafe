module break_continue_const_test;

import IO;

const
    MAX_ITEMS = 100;
    PI: Float64 = 3.14159;
    APP_NAME = "DelSafePhase44";
    FACTOR: Int32 = 2;

function AddWithFactor(x: Int32) return Int32 is
begin
    return x * FACTOR;
end AddWithFactor;

program Main;
var
    i: Int32;
    count: Int32;
    sum_val: Int32;
    res: Int32;
begin
    PrintLn("=== PHASE 44 TEST: BREAK, CONTINUE AND CONST ===");

    // 1. Constant validation
    assert(MAX_ITEMS = 100);
    assert(PI > 3.14);
    assert(PI < 3.15);
    assert(APP_NAME = "DelSafePhase44");

    res := AddWithFactor(21);
    assert(res = 42);

    // 2. Break in FOR loop
    count := 0;
    for i := 1 to 50 do
        count := i;
        if i = 5 then
            break;
        end if;
    end for;
    assert(count = 5);

    // 3. Continue in FOR loop (summing only odd numbers from 1 to 10)
    // Odds: 1, 3, 5, 7, 9 -> Sum = 25
    sum_val := 0;
    for i := 1 to 10 do
        if (i mod 2) = 0 then
            continue;
        end if;
        sum_val := sum_val + i;
    end for;
    assert(sum_val = 25);

    // 4. Break in WHILE loop
    count := 0;
    while true do
        count := count + 1;
        if count = 7 then
            break;
        end if;
    end while;
    assert(count = 7);

    // 5. Continue in WHILE loop
    // Sums only numbers >= 5 between 1 and 8: 5 + 6 + 7 + 8 = 26
    count := 0;
    sum_val := 0;
    while count < 8 do
        count := count + 1;
        if count < 5 then
            continue;
        end if;
        sum_val := sum_val + count;
    end while;
    assert(sum_val = 26);

    // 6. Break in REPEAT ... UNTIL loop
    count := 0;
    repeat
        count := count + 1;
        if count = 4 then
            break;
        end if;
    until count >= 20;
    assert(count = 4);

    PrintLn("Phase 44: All break, continue and const tests passed successfully!");
end break_continue_const_test.
