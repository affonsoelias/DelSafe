module match_and_ranges_test;

type
    JobState = (Queued, Running, Done);
    Point = record
        x: Int32;
        y: Int32;
    end record;
    User = record
        name: String;
        age: Int32;
        active: Bool;
    end record;
    IntList = array of Int32;
    StrList = array of String;

function ClassifyHttpAndInt(code: Int32) return Int32 is
var
    res: Int32;
begin
    res := 0;
    match code do
        1, 3, 5 =>
            res := 10;
        200..299 =>
            res := 2;
        -10..-1, 0 =>
            res := -1;
        _ =>
            res := 99;
    end match;
    return res;
end ClassifyHttpAndInt;

function ClassifyChar(c: Char) return Int32 is
var
    res: Int32;
begin
    res := 0;
    match c do
        'a'..'z' =>
            res := 1;
        'A'..'Z' =>
            res := 2;
        '0', '1', '2' =>
            res := 3;
        _ =>
            res := 9;
    end match;
    return res;
end ClassifyChar;

function CheckJobExhaustive(s: JobState) return Int32 is
var
    outVal: Int32;
begin
    outVal := 0;
    match s with
        case JobState.Queued, JobState.Running:
            outVal := 1;
        case JobState.Done:
            outVal := 2;
    end match;
    return outVal;
end CheckJobExhaustive;

function MethodGroup(m: String) return Int32 is
var
    res: Int32;
begin
    res := 0;
    match m do
        "GET", "HEAD" =>
            res := 1;
        "POST", "PUT" =>
            res := 2;
        _ =>
            res := 0;
    end match;
    return res;
end MethodGroup;

program Main;
var
    p1, pSel, zPoint: Point;
    usr, zUser: User;
    zInt, negVal, clamped1, clamped2, clamped3, inlineSum: Int32;
    zBool, hasLang: Bool;
    zStr, rawText, cleaned, tag, nestedLabel, repStr: String;
    zStatus: JobState;
    fAbs, fClamp: Float64;
    nums: IntList;
    subNums: IntList;
    words: StrList;
    subWords: StrList;
    flagTrue, flagFalse: Bool;
    inlineNum: Int32;
begin
    flagTrue := true;
    flagFalse := false;

    // 1. Multi-Value & Inclusive Range match
    Assert(ClassifyHttpAndInt(1) = 10);
    Assert(ClassifyHttpAndInt(3) = 10);
    Assert(ClassifyHttpAndInt(5) = 10);
    Assert(ClassifyHttpAndInt(200) = 2);
    Assert(ClassifyHttpAndInt(250) = 2);
    Assert(ClassifyHttpAndInt(299) = 2);
    Assert(ClassifyHttpAndInt(-10) = -1);
    Assert(ClassifyHttpAndInt(-5) = -1);
    Assert(ClassifyHttpAndInt(0) = -1);
    Assert(ClassifyHttpAndInt(404) = 99);

    Assert(ClassifyChar('m') = 1);
    Assert(ClassifyChar('Z') = 2);
    Assert(ClassifyChar('1') = 3);
    Assert(ClassifyChar('!') = 9);

    Assert(CheckJobExhaustive(JobState.Queued) = 1);
    Assert(CheckJobExhaustive(JobState.Running) = 1);
    Assert(CheckJobExhaustive(JobState.Done) = 2);

    Assert(MethodGroup("GET") = 1);
    Assert(MethodGroup("HEAD") = 1);
    Assert(MethodGroup("POST") = 2);
    Assert(MethodGroup("PUT") = 2);
    Assert(MethodGroup("DELETE") = 0);

    // 2. Named Record Constructors & Inline if..then..else
    p1 := Point(y: 20, x: 10);
    Assert(p1.x = 10);
    Assert(p1.y = 20);

    usr := User(active: true, age: 30, name: "Ana");
    Assert(usr.name = "Ana");
    Assert(usr.age = 30);
    Assert(usr.active);

    inlineNum := if p1.x < p1.y then 100 else 200;
    Assert(inlineNum = 100);

    tag := if flagFalse then "FAIL" else "PASS";
    Assert(tag = "PASS");

    nestedLabel := if p1.x > 100 then "A" else if p1.y = 20 then "B" else "C";
    Assert(nestedLabel = "B");

    inlineSum := (if flagTrue then 10 else 20) + 5;
    Assert(inlineSum = 15);

    pSel := if flagTrue then Point(y: 8, x: 4) else Point(y: 0, x: 0);
    Assert(pSel.x = 4);
    Assert(pSel.y = 8);

    // 3. Default(T)
    zInt := Default(Int32);
    Assert(zInt = 0);
    zStr := Default(String);
    Assert(zStr = "");
    zBool := Default(Bool);
    Assert(not zBool);
    zPoint := Default(Point);
    Assert((zPoint.x = 0) and (zPoint.y = 0));
    zUser := Default(User);
    Assert((zUser.name = "") and (zUser.age = 0) and (not zUser.active));
    zStatus := Default(JobState);
    Assert(Ord(zStatus) = 0);

    // 4. Built-in String & Math (UFCS + Functional)
    rawText := "  Aether Lang  ";
    cleaned := rawText.Trim();
    Assert(cleaned = "Aether Lang");
    Assert(UpperCase(cleaned) = "AETHER LANG");
    Assert(cleaned.LowerCase() = "aether lang");
    Assert(cleaned.StartsWith("Aether"));
    Assert(not cleaned.StartsWith("Lang"));
    Assert(cleaned.EndsWith("Lang"));
    hasLang := cleaned.Contains("Lang");
    Assert(hasLang);
    Assert(not cleaned.Contains("Rust"));
    Assert(cleaned.IndexOf("Lang") = 7);
    Assert(cleaned.IndexOf("Missing") = -1);
    repStr := cleaned.Replace("Lang", "2026");
    Assert(repStr = "Aether 2026");
    Assert(Replace("a-b-a", "a", "X") = "X-b-X");

    negVal := -42;
    Assert(Abs(negVal) = 42);
    Assert(negVal.Abs() = 42);
    Assert(Min(15, 8) = 8);
    Assert(Max(15, 8) = 15);
    clamped1 := Clamp(-5, 0, 100);
    clamped2 := Clamp(150, 0, 100);
    clamped3 := negVal.Abs().Clamp(0, 30);
    Assert((clamped1 = 0) and (clamped2 = 100) and (clamped3 = 30));

    fAbs := Abs(-3.5);
    fClamp := Clamp(12.5, 0.0, 10.0);
    Assert(fAbs > 3.4);
    Assert(fClamp < 10.1);
    Assert(fClamp > 9.9);

    // 5. Dynamic Array Slice, Insert & Delete
    nums := [10, 20, 30, 40, 50];
    nums.Delete(2);
    Assert(nums.Length() = 4);
    Assert(nums[0] = 10);
    Assert(nums[1] = 20);
    Assert(nums[2] = 40);
    Assert(nums[3] = 50);

    nums.Insert(1, 99);
    Assert(nums.Length() = 5);
    Assert(nums[0] = 10);
    Assert(nums[1] = 99);
    Assert(nums[2] = 20);
    Assert(nums[4] = 50);

    subNums := nums.Slice(1, 3);
    Assert(subNums.Length() = 3);
    Assert(subNums[0] = 99);
    Assert(subNums[1] = 20);
    Assert(subNums[2] = 40);

    words := ["A", "B", "C"];
    words.Insert(3, "D");
    words.Delete(0);
    subWords := Slice(words, 0, 2);
    Assert(subWords.Length() = 2);
    Assert(subWords[0] = "B");
    Assert(subWords[1] = "C");

    PrintLn("=== PHASE 48 TEST PASSED (MATCH RANGE/MULTI, IF EXPR, STR/MATH, SLICE/INSERT/DELETE, NAMED CTOR/DEFAULT) ===");
end match_and_ranges_test.
