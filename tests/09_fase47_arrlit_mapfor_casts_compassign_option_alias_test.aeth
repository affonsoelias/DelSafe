module Fase47ArrlitMapforCastsCompassignOptionAliasTest;

type
    UserId = Int64;
    ByteVal = UInt8;
    IntPtr = ^Int32;
    StatusFlag = (Idle, Running, Done);
    Ponto = record
        x: Int32;
        y: Int32;
    end;
    Vet3 = array[3] of Int32;
    Placar = map[String]Int32;

function FindPositive(n: Int32): Option<Int32>
begin
    if n > 0 then
        return Some(n * 10);
    end;
    return None;
end;

function FindLabel(flag: Bool): Option<String>
begin
    if flag then
        return Some("OkTag");
    end;
    return None;
end;

function ParsePort(p: Int32): Result<Int32, String>
begin
    if (p > 0) and (p <= 65535) then
        return Ok(p);
    end;
    return Err("porta invalida");
end;

function MakeTextResult(ok: Bool): Result<String, Int32>
begin
    if ok then
        return Ok("Aether");
    end;
    return Err(503);
end;

program Main;
var
    uid: UserId;
    rawByte: ByteVal;
    pRaw: IntPtr;
    targetVal: Int32;
    pt: Ponto;
    nums := [10, 20, 30];
    words := ["Alpha", "Beta"];
    fixo: Vet3 := [1, 2, 3];
    lastNum, poppedWordCheck, totalSum, keyCount, acc, cnt, szInt64, szPonto: Int32;
    poppedWord: String;
    scores: Placar;
    txt := "Aether";
    optInt, optNone: Option<Int32>;
    optStr, optStrNone: Option<String>;
    optSum, errCount: Int32;
    resOk, resErr: Result<Int32, String>;
    resStr: Result<String, Int32>;
    boxOpt: Option<Box<Ponto>>;
begin
    // 1. Type Aliases Simples e Casts / SizeOf / Ord / Chr / String[i]
    uid := UserId(123456);
    rawByte := ByteVal(250);
    Assert(uid = 123456);
    Assert(rawByte = 250);
    Assert(Int32(3.9) = 3);
    Assert(Int64(uid) = 123456);
    Assert(Ord('A') = 65);
    Assert(Chr(66) = 'B');
    Assert(Ord(StatusFlag.Running) = 1);
    szInt64 := SizeOf(Int64);
    szPonto := SizeOf(Ponto);
    Assert(szInt64 = 8);
    Assert(szPonto >= 8);
    Assert(txt[0] = 'A');
    Assert(txt[5] = 'r');

    // Ponteiro via Type Alias + unsafe
    targetVal := 77;
    pRaw := @targetVal;
    unsafe
        pRaw^ := 88;
    end;
    Assert(targetVal = 88);

    // 2. Literais de Array ([...]), Pop e Clear
    Assert(nums.Length() = 3);
    Assert(nums[0] = 10);
    Assert(nums[2] = 30);
    lastNum := nums.Pop();
    Assert(lastNum = 30);
    Assert(nums.Length() = 2);
    nums.Clear();
    Assert(nums.Length() = 0);

    poppedWord := words.Pop();
    poppedWordCheck := 0;
    if poppedWord = "Beta" then
        poppedWordCheck := 1;
    end;
    Assert(poppedWordCheck = 1);
    words.Clear();
    Assert(words.Length() = 0);

    Assert(fixo[0] = 1);
    Assert(fixo[2] = 3);
    fixo := [7, 8, 9];
    Assert(fixo[0] = 7);
    Assert(fixo[2] = 9);

    // 3. Atribuicao Composta (+=, -=, *=) e Inc/Dec
    acc := 10;
    acc += 5;
    acc -= 3;
    acc *= 4;
    Assert(acc = 48);

    pt := Ponto(10, 4);
    pt.x += 5;
    pt.y *= 3;
    Assert(pt.x = 15);
    Assert(pt.y = 12);

    fixo[1] += 10;
    Assert(fixo[1] = 18);

    cnt := 0;
    Inc(cnt);
    Inc(cnt, 9);
    Dec(cnt);
    Dec(cnt, 2);
    Assert(cnt = 7);

    // 4. Iteracao em Mapas (for k in map / for k, v in map) + Clear + += em mapas
    scores["Alice"] := 10;
    scores["Bob"] := 20;
    scores["Alice"] += 5;
    Assert(scores["Alice"] = 15);

    keyCount := 0;
    for kOnly in scores do
        if kOnly <> "" then
            Inc(keyCount);
        end;
    end;
    Assert(keyCount = 2);

    totalSum := 0;
    for kName, vScore in scores do
        if kName <> "" then
            totalSum += vScore;
        end;
    end;
    Assert(totalSum = 35);

    scores.Clear();
    Assert(scores.Count() = 0);

    // 5. Option<T> por valor e Option<Box<T>> + Result<T, E> tipado
    optInt := FindPositive(5);
    optNone := FindPositive(0);
    Assert(optInt.is_some);
    Assert(not optInt.is_none);
    Assert(optInt.value = 50);
    Assert(optNone.is_none);
    Assert(not optNone.is_some);

    optSum := 0;
    match optInt with
        case Some(let x):
            optSum += x;
        case None:
            optSum -= 1;
    end;
    match optNone with
        case Some(let z):
            optSum += z;
        case None:
            optSum += 5;
    end;
    Assert(optSum = 55);

    optStr := FindLabel(true);
    optStrNone := FindLabel(false);
    Assert(optStr.is_some);
    Assert(optStr.value = "OkTag");
    Assert(optStrNone.is_none);

    boxOpt := Some(Box(Ponto(3, 4)));
    Assert(boxOpt.is_some);
    Assert(boxOpt.value.x = 3);

    resOk := ParsePort(8080);
    resErr := ParsePort(-5);
    errCount := 0;
    match resOk with
        case Ok(let p):
            errCount += p;
        case Err(let errMsg):
            if errMsg <> "" then
                Inc(errCount);
            end;
    end;
    match resErr with
        case Ok(let pIgnore):
            errCount += pIgnore;
        case Err(let msg):
            if msg = "porta invalida" then
                errCount += 100;
            end;
    end;
    Assert(errCount = 8180);

    resStr := MakeTextResult(true);
    Assert(resStr.is_ok);
    Assert(resStr.value = "Aether");

    PrintLn("=== FASE 47 TEST PASSOU (ARRLIT, MAPFOR, CASTS, COMPASS, OPTION/RESULT REAL, ALIAS) ===");
end.
