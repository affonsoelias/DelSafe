module helper_fase54_mod;

interface

const
    PUBLIC_FACTOR = 3;

type
    Nivel = enum
        Baixo,
        Medio,
        Alto
    end;

type
    [derive(Debug, JSON, Clone, Equals)]
    Caixa = record
        pub titulo: String;
        priv secret: Int32;
    end;

function Escalar(n: Int32) return Int32;

implementation

const
    SECRET_SALT = 999;

impl Caixa
    pub function Create(lbl: String; sec: Int32) return Self is
    begin
        return Caixa(lbl, sec);
    end Create;

    pub function ReadSecret(borrow self) return Int32 is
    begin
        return self.secret;
    end ReadSecret;
end;

function HelperInterno(n: Int32) return Int32 is
begin
    return n + SECRET_SALT;
end HelperInterno;

function Escalar(n: Int32) return Int32 is
begin
    return (n * PUBLIC_FACTOR) + HelperInterno(0) - SECRET_SALT;
end Escalar;

end helper_fase54_mod.
