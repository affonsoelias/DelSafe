module SuiteMatematicaTest;

function Add(a, b: Int32) return Int32 is
begin
    return a + b;
end Add;

function Multiply(a, b: Int32) return Int32 is
begin
    return a * b;
end Multiply;

program Main;
var
    sum_res: Int32;
    prod_res: Int32;
begin
    PrintLn("Running Math Test Suite...");

    sum_res := Add(20, 22);
    Assert(sum_res = 42, "Sum of 20 and 22 must be 42");

    prod_res := Multiply(6, 7);
    Assert(prod_res = 42, "Product of 6 and 7 must be 42");

    Assert(sum_res = prod_res, "Add and Multiply must yield the same result");

    PrintLn("All math tests passed successfully!");
end SuiteMatematicaTest.
