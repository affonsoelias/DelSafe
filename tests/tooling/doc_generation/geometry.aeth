/// High-precision geometric and statistical calculations module.
/// Provides data structures, formal contracts, and functions with strict ownership semantics.
module geometry;

type
    /// Represents a 2D Point on the Cartesian plane.
    Point = record
        /// Horizontal X coordinate.
        x: Float64;
        /// Vertical Y coordinate.
        y: Float64;
    end record;

    /// Rendering mode for geometric shapes.
    RenderMode = enum
        Wireframe,
        Solid,
        Textured
    end enum;

/// Contract for geometric shapes supporting area calculation.
trait GeometricShape
    function ComputeArea(borrow self: Point) return Float64;
end trait;

/// Creates a new point on the Cartesian plane.
/// @param x X coordinate
/// @param y Y coordinate
/// @return A new Point instance with transferred ownership
///
/// ```aether
/// var p: Point := CreatePoint(10.0, 20.0);
/// Assert(p.x > 0.0);
/// ```
function CreatePoint(x, y: Float64) return Point is
contract
    require
        x >= 0.0;
        y >= 0.0;
    ensure
        result.x >= 0.0;
var
    res: Point;
begin
    res.x := x;
    res.y := y;
    return res;
end CreatePoint;

/// Translates the coordinates of a point directly in memory.
/// @param p Mutable reference to the point to modify
/// @param dx Horizontal offset
/// @param dy Vertical offset
procedure ShiftPoint(mut borrow p: Point; dx, dy: Float64) is
begin
    p.x := p.x + dx;
    p.y := p.y + dy;
end ShiftPoint;

/// Asynchronously computes the area of a bounding rectangle.
/// @param width Total width of the rectangle
/// @param height Total height of the rectangle
/// @return Task containing the computed area
async function ComputeAreaAsync(width, height: Float64) return Float64 is
contract
    require
        width > 0.0;
        height > 0.0;
begin
    return width * height;
end ComputeAreaAsync;

program Main;
var
    p: Point;
begin
    p := CreatePoint(5.0, 10.0);
    ShiftPoint(mut borrow p, 2.0, 3.0);
    PrintLn("Point X: " + FloatToStr(p.x));
    PrintLn("Point Y: " + FloatToStr(p.y));
end geometry.
