module Fase44BreakContinueConstTest;

import IO;

const
    MAX_ITEMS = 100;
    PI: Float64 = 3.14159;
    APP_NAME = "AetherFase44";
    FACTOR: Int32 = 2;

function SomarComFator(x: Int32): Int32
begin
    return x * FACTOR;
end;

program Main;
var
    i: Int32;
    count: Int32;
    soma: Int32;
    res: Int32;
begin
    PrintLn("=== TESTE DA FASE 44: BREAK, CONTINUE E CONST ===");

    // 1. Validacao de Constantes
    assert(MAX_ITEMS = 100);
    assert(PI > 3.14);
    assert(PI < 3.15);
    assert(APP_NAME = "AetherFase44");

    res := SomarComFator(21);
    assert(res = 42);

    // 2. Break em laco FOR
    count := 0;
    for i := 1 to 50 do
        count := i;
        if i = 5 then
            break;
        end;
    end;
    assert(count = 5);

    // 3. Continue em laco FOR (somando apenas numeros impares de 1 a 10)
    // Impares: 1, 3, 5, 7, 9 -> Soma = 25
    soma := 0;
    for i := 1 to 10 do
        if (i mod 2) = 0 then
            continue;
        end;
        soma := soma + i;
    end;
    assert(soma = 25);

    // 4. Break em laco WHILE
    count := 0;
    while true do
        count := count + 1;
        if count = 7 then
            break;
        end;
    end;
    assert(count = 7);

    // 5. Continue em laco WHILE
    // Soma apenas numeros >= 5 entre 1 e 8: 5 + 6 + 7 + 8 = 26
    count := 0;
    soma := 0;
    while count < 8 do
        count := count + 1;
        if count < 5 then
            continue;
        end;
        soma := soma + count;
    end;
    assert(soma = 26);

    // 6. Break em laco REPEAT ... UNTIL
    count := 0;
    repeat
        count := count + 1;
        if count = 4 then
            break;
        end;
    until count >= 20;
    assert(count = 4);

    PrintLn("Fase 44: Todos os testes de break, continue e const passaram com sucesso!");
end.
