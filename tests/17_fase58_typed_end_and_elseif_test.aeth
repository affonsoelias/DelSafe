module Fase58TypedEndAndElseIfTest;

type
    Metric = record
        x: Int32;
        y: Int32;
    end record;

    Level = enum
        Low,
        Medium,
        High
    end enum;

    Describable = trait
        function Describe(borrow self) return String;
    end trait;

impl Describable for Metric
    function Describe(borrow self) return String is
    begin
        return "Metric(" + IntToStr(self.x) + "," + IntToStr(self.y) + ")";
    end Describe;
end impl;

impl Metric
    function CreateZero() return Self is
    begin
        return Metric(0, 0);
    end CreateZero;

    function Sum(borrow self) return Int32 is
    begin
        return self.x + self.y;
    end Sum;
end impl;

function GradeScore(score: Int32) return String is
var
    grade: String;
begin
    if score >= 90 then
        grade := "A";
    else if score >= 80 then
        grade := "B";
    else if score >= 70 then
        grade := "C";
    else
        grade := "F";
    end if;
    return grade;
end GradeScore;

function ClassifyTwoSpaces(borrow text: String) return Int32 is
var
    first_space, second_space, len, i: Int32;
    ch: String;
begin
    first_space := -1;
    second_space := -1;
    len := Int32(Length(borrow text));
    i := 0;
    while i < len do
        ch := CharAt(borrow text, UInt32(i));
        if ch = " " then
            if first_space = -1 then
                first_space := i;
            else if second_space = -1 then
                second_space := i;
            end if;
        end if;
        i := i + 1;
    end while;
    return first_space * 100 + second_space;
end ClassifyTwoSpaces;

function NestedIfInsideElse(flag, inner: Bool) return Int32 is
var
    extra: Int32;
begin
    extra := 0;
    if flag then
        extra := 100;
    else
        if inner then
            extra := 10;
        end if;
        extra := extra + 1;
    end if;
    return extra;
end NestedIfInsideElse;

program Main;
var
    m0, m1: Metric;
    lv: Level;
    i, sumFor, sumDown, sumArr, rep, rawVal: Int32;
    ptr: ^Int32;
    caught: Bool;
    arr: array of Int32;
    matchLabel, inlineTag: String;
begin
    // 1. Typed end declarations (record, enum, trait, impl)
    m0 := Metric.CreateZero();
    Assert(m0.Sum() = 0);
    m1 := Metric(15, 27);
    Assert(m1.Sum() = 42);
    Assert(m1.Describe() = "Metric(15,27)");

    // 2. Flattened else if chain with single end if;
    Assert(GradeScore(95) = "A");
    Assert(GradeScore(85) = "B");
    Assert(GradeScore(72) = "C");
    Assert(GradeScore(50) = "F");

    // 3. else if chain without trailing else inside while..end while;
    Assert(ClassifyTwoSpaces(borrow "GET /api HTTP") = 308);
    Assert(ClassifyTwoSpaces(borrow "PING") = -101);

    // 4. True nested if inside else (next line) + extra statement
    Assert(NestedIfInsideElse(true, false) = 100);
    Assert(NestedIfInsideElse(false, true) = 11);
    Assert(NestedIfInsideElse(false, false) = 1);

    // 5. Inline if expression (no end)
    inlineTag := if m1.Sum() > 40 then "BIG" else "SMALL";
    Assert(inlineTag = "BIG");

    // 6. for loops (to, downto, for..in -> end for;) and repeat..until
    sumFor := 0;
    for i := 1 to 5 do
        sumFor := sumFor + i;
    end for;
    Assert(sumFor = 15);

    sumDown := 0;
    for i := 3 downto 1 do
        sumDown := sumDown + i;
    end for;
    Assert(sumDown = 6);

    arr := [2, 4, 6];
    sumArr := 0;
    for i in arr do
        sumArr := sumArr + i;
    end for;
    Assert(sumArr = 12);

    rep := 0;
    repeat
        rep := rep + 1;
    until rep = 3;
    Assert(rep = 3);

    // 7. match statement (end match;) and match expression (end match)
    lv := Level.Medium;
    match lv do
        case Level.Low:
            Assert(false);
        case Level.Medium:
            sumFor := sumFor + 1;
        case Level.High:
            Assert(false);
    end match;
    Assert(sumFor = 16);

    matchLabel := match lv do
        case Level.Low => "low";
        case Level.Medium => "medium";
        case Level.High => "high";
    end match;
    Assert(matchLabel = "medium");

    // 8. try..except (end try;) and unsafe (end unsafe;)
    caught := false;
    try
        raise "boom";
    except
        caught := true;
    end try;
    Assert(caught);

    rawVal := 7;
    ptr := @rawVal;
    unsafe
        ptr^ := ptr^ + 35;
    end unsafe;
    Assert(rawVal = 42);

    PrintLn("=== PHASE 58 TEST PASSED (TYPED END AND FLATTENED ELSE IF) ===");
end Fase58TypedEndAndElseIfTest.
