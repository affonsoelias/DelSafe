module Main;

import IO;
import Strings;
import Collections;
import Tokens;
import Lexer;
import AST;
import Parser;
import TypeChecker;
import BorrowChecker;
import Emitter;

program Main;
var
    input_path: String;
    output_path: String;
    source_code: String;
    parser: ParserState;
    sb: StringBuilder;
    structs_opt: Option<Box<ASTStructNode>>;
    funcs_opt: Option<Box<ASTFunctionNode>>;
    var_decls: ASTStmtNode;
    body_stmts: ASTStmtNode;
    root_stmt: ASTStmtNode;
    c_code: String;
    write_ok: Bool;
    type_errors: UInt32;
    borrow_errors: UInt32;
begin
    PrintLn("====================================================================");
    PrintLn("  AetherLang Self-Hosted Compiler (aetherc-core) - Phase 23         ");
    PrintLn("  100% Autonomous Aether Compiler written in the Aether language!     ");
    PrintLn("====================================================================");
    PrintLn("");

    if ParamCount() >= 1 then
        input_path := ParamStr(1);
        if ParamCount() >= 3 then
            if ParamStr(2) = "-o" then
                output_path := ParamStr(3);
            else
                output_path := ParamStr(2);
            end;
        else
            if ParamCount() >= 2 then
                output_path := ParamStr(2);
            else
                output_path := "bin/self_hosted_output.c";
            end;
        end;
    else
        PrintLn("Usage: aetherc-core <file.aeth> [-o output.c]");
        PrintLn("No file specified. Running default demonstration...");
        PrintLn("");
        input_path := "examples/13_self_hosted_compiler_demo.aeth";
        output_path := "bin/self_hosted_output.c";
    end;

    PrintLn("[1/4] Lexical and Syntax Analysis of \"%s\"...", input_path);
    source_code := ReadFile(borrow input_path);

    if Length(borrow source_code) > 0 then
        PrintLn("      Source read successfully (%d bytes).", Length(borrow source_code));

        parser := NewParser(borrow source_code);
        structs_opt := None;
        funcs_opt := None;
        var_decls := NewVarDeclStmt(borrow "", borrow "");

        // 1. Search for 'type' section for structs
        while (not IsAtEnd(borrow parser.lexer)) and (parser.current.kind <> TokenKind.tkType) and (parser.current.kind <> TokenKind.tkFunction) and (parser.current.kind <> TokenKind.tkVar) and (parser.current.kind <> TokenKind.tkBegin) do
            AdvanceParser(mut borrow parser);
        end;

        if parser.current.kind = TokenKind.tkType then
            structs_opt := ParseStructs(mut borrow parser);
        end;

        // 2. Search for 'function' section for top-level functions
        while (not IsAtEnd(borrow parser.lexer)) and (parser.current.kind <> TokenKind.tkFunction) and (parser.current.kind <> TokenKind.tkVar) and (parser.current.kind <> TokenKind.tkBegin) do
            AdvanceParser(mut borrow parser);
        end;

        if parser.current.kind = TokenKind.tkFunction then
            funcs_opt := ParseFunctions(mut borrow parser);
        end;

        // 3. Search for 'var' or 'begin' section of program
        while (not IsAtEnd(borrow parser.lexer)) and (parser.current.kind <> TokenKind.tkVar) and (parser.current.kind <> TokenKind.tkBegin) do
            AdvanceParser(mut borrow parser);
        end;

        if parser.current.kind = TokenKind.tkVar then
            AdvanceParser(mut borrow parser); // consume 'var'
            var_decls := ParseVarSection(mut borrow parser);
        end;

        // 4. Search for program 'begin'
        while (not IsAtEnd(borrow parser.lexer)) and (parser.current.kind <> TokenKind.tkBegin) do
            AdvanceParser(mut borrow parser);
        end;

        if parser.current.kind = TokenKind.tkBegin then
            AdvanceParser(mut borrow parser); // Consume 'begin'
        end;

        body_stmts := ParseBlock(mut borrow parser);
        root_stmt := AppendStmt(take var_decls, take body_stmts);
        PrintLn("      Syntax Analysis completed successfully.");

        // [2/4] Type Checking (Native Type Checker)
        PrintLn("[2/4] Type Checking: Running native Type Checker...");
        type_errors := TypeCheckProgram(borrow funcs_opt, borrow root_stmt);
        if type_errors = 0 then
            PrintLn("      Type Checking: OK (0 errors)");
        else
            PrintLn("      [ERROR] Type Checking failed with %d errors.", type_errors);
        end;

        // [3/4] Ownership Checking (Native Borrow Checker)
        PrintLn("[3/4] Ownership Checking: Running native Borrow Checker...");
        borrow_errors := BorrowCheckAST(borrow root_stmt);
        if borrow_errors = 0 then
            PrintLn("      Ownership Checking: OK (0 errors)");
        else
            PrintLn("      [ERROR] Ownership Checking failed with %d errors.", borrow_errors);
        end;

        if (type_errors = 0) and (borrow_errors = 0) then
            // [4/4] C99 Code Emission
            PrintLn("[4/4] C99 Code Emission...");
            sb := NewStringBuilder();
            sb.Append(borrow "// Generated by the Aether Self-Hosted Compiler (aetherc-core) - Phase 23\n");
            sb.Append(borrow "#include <stdio.h>\n");
            sb.Append(borrow "#include <stdint.h>\n");
            sb.Append(borrow "#include <stdbool.h>\n\n");

            if structs_opt.is_some then
                sb.Append(borrow EmitStructsC(borrow structs_opt));
            end;

            if funcs_opt.is_some then
                sb.Append(borrow EmitFunctionsC(borrow funcs_opt));
            end;

            sb.Append(borrow "int main(void) {\n");

            c_code := EmitBlockC(borrow root_stmt);
            sb.Append(borrow c_code);

            sb.Append(borrow "    return 0;\n");
            sb.Append(borrow "}\n");

            PrintLn("      Writing generated C code to \"%s\"...", output_path);
            write_ok := WriteFile(borrow output_path, borrow sb.ToString());

            if write_ok then
                PrintLn("[SUCCESS] Code generated by self-hosted compiler!");
                PrintLn("");
                PrintLn("--- Generated C99 Code: ---");
                PrintLn("%s", sb.ToString());
                PrintLn("--------------------------");
            else
                PrintLn("[ERROR] Failed to save output file.");
            end;
        else
            PrintLn("[FAIL] Compilation aborted due to semantic or ownership errors.");
        end;
    else
        PrintLn("[ERROR] Could not read input file.");
    end;
end.
