module Main;

import IO;
import Strings;
import Collections;
import Tokens;
import Lexer;
import AST;
import Parser;
import TypeChecker;
import BorrowChecker;
import Emitter;

program Main;
var
    caminho_entrada: String;
    caminho_saida: String;
    codigo_fonte: String;
    parser: ParserState;
    sb: StringBuilder;
    structs_opt: Option<Box<ASTStructNode>>;
    funcs_opt: Option<Box<ASTFunctionNode>>;
    var_decls: ASTStmtNode;
    body_stmts: ASTStmtNode;
    root_stmt: ASTStmtNode;
    codigo_c: String;
    ok_escrita: Bool;
    erros_tipo: UInt32;
    erros_posse: UInt32;
begin
    PrintLn("====================================================================");
    PrintLn("  AetherLang Self-Hosted Compiler (aetherc-core) - Fase 23          ");
    PrintLn("  Compilador Aether 100% Autônomo escrito na linguagem Aether!      ");
    PrintLn("====================================================================");
    PrintLn("");

    if ParamCount() >= 1 then
        caminho_entrada := ParamStr(1);
        if ParamCount() >= 3 then
            if ParamStr(2) = "-o" then
                caminho_saida := ParamStr(3);
            else
                caminho_saida := ParamStr(2);
            end;
        else
            if ParamCount() >= 2 then
                caminho_saida := ParamStr(2);
            else
                caminho_saida := "bin/self_hosted_output.c";
            end;
        end;
    else
        PrintLn("Uso: aetherc-core <arquivo.aeth> [-o saida.c]");
        PrintLn("Nenhum arquivo informado. Executando demonstracao padrao...");
        PrintLn("");
        caminho_entrada := "examples/13_self_hosted_compiler_demo.aeth";
        caminho_saida := "bin/self_hosted_output.c";
    end;

    PrintLn("[1/4] Analise Lexica e Sintatica de \"%s\"...", caminho_entrada);
    codigo_fonte := ReadFile(borrow caminho_entrada);

    if Length(borrow codigo_fonte) > 0 then
        PrintLn("      Fonte lido com sucesso (%d bytes).", Length(borrow codigo_fonte));

        parser := NewParser(borrow codigo_fonte);
        structs_opt := None;
        funcs_opt := None;
        var_decls := NewVarDeclStmt(borrow "", borrow "");

        // 1. Procura secao 'type' para structs
        while (not IsAtEnd(borrow parser.lexer)) and (parser.current.kind <> TokenKind.tkType) and (parser.current.kind <> TokenKind.tkFunction) and (parser.current.kind <> TokenKind.tkVar) and (parser.current.kind <> TokenKind.tkBegin) do
            AdvanceParser(mut borrow parser);
        end;

        if parser.current.kind = TokenKind.tkType then
            structs_opt := ParseStructs(mut borrow parser);
        end;

        // 2. Procura secao 'function' para funcoes de topo
        while (not IsAtEnd(borrow parser.lexer)) and (parser.current.kind <> TokenKind.tkFunction) and (parser.current.kind <> TokenKind.tkVar) and (parser.current.kind <> TokenKind.tkBegin) do
            AdvanceParser(mut borrow parser);
        end;

        if parser.current.kind = TokenKind.tkFunction then
            funcs_opt := ParseFunctions(mut borrow parser);
        end;

        // 3. Procura secao 'var' ou 'begin' do programa
        while (not IsAtEnd(borrow parser.lexer)) and (parser.current.kind <> TokenKind.tkVar) and (parser.current.kind <> TokenKind.tkBegin) do
            AdvanceParser(mut borrow parser);
        end;

        if parser.current.kind = TokenKind.tkVar then
            AdvanceParser(mut borrow parser); // consome 'var'
            var_decls := ParseVarSection(mut borrow parser);
        end;

        // 4. Procura 'begin' do programa
        while (not IsAtEnd(borrow parser.lexer)) and (parser.current.kind <> TokenKind.tkBegin) do
            AdvanceParser(mut borrow parser);
        end;

        if parser.current.kind = TokenKind.tkBegin then
            AdvanceParser(mut borrow parser); // Consome 'begin'
        end;

        body_stmts := ParseBlock(mut borrow parser);
        root_stmt := AppendStmt(take var_decls, take body_stmts);
        PrintLn("      Analise Sintatica concluida com exito.");

        // [2/4] Verificacao de Tipos (Type Checker Nativo)
        PrintLn("[2/4] Verificacao de Tipos: Executando Type Checker nativo...");
        erros_tipo := TypeCheckProgram(borrow funcs_opt, borrow root_stmt);
        if erros_tipo = 0 then
            PrintLn("      Verificacao de Tipos: OK (0 erros)");
        else
            PrintLn("      [ERRO] Verificacao de Tipos falhou com %d erros.", erros_tipo);
        end;

        // [3/4] Verificacao de Posse (Borrow Checker Nativo)
        PrintLn("[3/4] Verificacao de Posse: Executando Borrow Checker nativo...");
        erros_posse := BorrowCheckAST(borrow root_stmt);
        if erros_posse = 0 then
            PrintLn("      Verificacao de Posse: OK (0 erros)");
        else
            PrintLn("      [ERRO] Verificacao de Posse falhou com %d erros.", erros_posse);
        end;

        if (erros_tipo = 0) and (erros_posse = 0) then
            // [4/4] Emissao de Codigo C99
            PrintLn("[4/4] Emissao de Codigo C99...");
            sb := NewStringBuilder();
            sb.Append(borrow "// Gerado pelo Compilador Auto-Hospedado Aether (aetherc-core) - Fase 23\n");
            sb.Append(borrow "#include <stdio.h>\n");
            sb.Append(borrow "#include <stdint.h>\n");
            sb.Append(borrow "#include <stdbool.h>\n\n");

            if structs_opt.is_some then
                sb.Append(borrow EmitStructsC(borrow structs_opt));
            end;

            if funcs_opt.is_some then
                sb.Append(borrow EmitFunctionsC(borrow funcs_opt));
            end;

            sb.Append(borrow "int main(void) {\n");

            codigo_c := EmitBlockC(borrow root_stmt);
            sb.Append(borrow codigo_c);

            sb.Append(borrow "    return 0;\n");
            sb.Append(borrow "}\n");

            PrintLn("      Gravando codigo C gerado em \"%s\"...", caminho_saida);
            ok_escrita := WriteFile(borrow caminho_saida, borrow sb.ToString());

            if ok_escrita then
                PrintLn("[SUCESSO] Codigo gerado pelo compilador auto-hospedado com exito!");
                PrintLn("");
                PrintLn("--- Codigo C99 Gerado: ---");
                PrintLn("%s", sb.ToString());
                PrintLn("--------------------------");
            else
                PrintLn("[ERRO] Falha ao salvar arquivo de saida.");
            end;
        else
            PrintLn("[FALHA] Compilacao abortada devido a erros semanticos ou de posse.");
        end;
    else
        PrintLn("[ERRO] Nao foi possivel ler o arquivo de entrada.");
    end;
end.
