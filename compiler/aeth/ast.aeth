module AST;

type
    ASTExprKind = enum
        ekIntLiteral,
        ekStringLiteral,
        ekBoolLiteral,
        ekIdentifier,
        ekBinary,
        ekCall
    end;

    ASTExprNode = record
        kind: ASTExprKind;
        str_val: String;
        op: String;
        left: Option<Box<ASTExprNode>>;
        right: Option<Box<ASTExprNode>>;
    end;

    ASTStmtKind = enum
        skVarDecl,
        skAssign,
        skPrintLn,
        skIf,
        skWhile,
        skReturn
    end;

    ASTStmtNode = record
        kind: ASTStmtKind;
        name: String;
        type_name: String;
        expr: Option<Box<ASTExprNode>>;
        then_branch: Option<Box<ASTStmtNode>>;
        else_branch: Option<Box<ASTStmtNode>>;
        next: Option<Box<ASTStmtNode>>;
    end;

function NewIntExpr(borrow s: String): ASTExprNode
begin
    return ASTExprNode(kind: ASTExprKind.ekIntLiteral, str_val: s, op: "", left: None, right: None);
end;

function NewStringExpr(borrow s: String): ASTExprNode
begin
    return ASTExprNode(kind: ASTExprKind.ekStringLiteral, str_val: s, op: "", left: None, right: None);
end;

function NewBoolExpr(borrow s: String): ASTExprNode
begin
    return ASTExprNode(kind: ASTExprKind.ekBoolLiteral, str_val: s, op: "", left: None, right: None);
end;

function NewIdentExpr(borrow s: String): ASTExprNode
begin
    return ASTExprNode(kind: ASTExprKind.ekIdentifier, str_val: s, op: "", left: None, right: None);
end;

function NewBinaryExpr(borrow op_str: String; take l: ASTExprNode; take r: ASTExprNode): ASTExprNode
begin
    return ASTExprNode(kind: ASTExprKind.ekBinary, str_val: "", op: op_str, left: Some(Box(l)), right: Some(Box(r)));
end;

function NewCallExpr(borrow callee: String; take arg: ASTExprNode): ASTExprNode
begin
    return ASTExprNode(kind: ASTExprKind.ekCall, str_val: callee, op: "", left: Some(Box(arg)), right: None);
end;

function NewVarDeclStmt(borrow vname: String; borrow tname: String): ASTStmtNode
begin
    return ASTStmtNode(kind: ASTStmtKind.skVarDecl, name: vname, type_name: tname, expr: None, then_branch: None, else_branch: None, next: None);
end;

function NewAssignStmt(borrow vname: String; take e: ASTExprNode): ASTStmtNode
begin
    return ASTStmtNode(kind: ASTStmtKind.skAssign, name: vname, type_name: "", expr: Some(Box(e)), then_branch: None, else_branch: None, next: None);
end;

function NewPrintLnStmt(take e: ASTExprNode): ASTStmtNode
begin
    return ASTStmtNode(kind: ASTStmtKind.skPrintLn, name: "PrintLn", type_name: "", expr: Some(Box(e)), then_branch: None, else_branch: None, next: None);
end;

function NewIfStmt(take cond: ASTExprNode; take then_st: ASTStmtNode; take else_st: ASTStmtNode): ASTStmtNode
begin
    return ASTStmtNode(kind: ASTStmtKind.skIf, name: "if", type_name: "", expr: Some(Box(cond)), then_branch: Some(Box(then_st)), else_branch: Some(Box(else_st)), next: None);
end;

function NewWhileStmt(take cond: ASTExprNode; take body_st: ASTStmtNode): ASTStmtNode
begin
    return ASTStmtNode(kind: ASTStmtKind.skWhile, name: "while", type_name: "", expr: Some(Box(cond)), then_branch: Some(Box(body_st)), else_branch: None, next: None);
end;

function NewReturnStmt(take e: ASTExprNode): ASTStmtNode
begin
    return ASTStmtNode(kind: ASTStmtKind.skReturn, name: "return", type_name: "", expr: Some(Box(e)), then_branch: None, else_branch: None, next: None);
end;
