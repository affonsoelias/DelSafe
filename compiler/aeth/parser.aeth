module Parser;

import Tokens;
import Lexer;
import AST;

type
    ParserState = record
        lexer: Lexer;
        current: Token;
        has_error: Bool;
    end;

function NewParser(borrow src: String): ParserState
var
    lex: Lexer;
    first_tok: Token;
begin
    lex := NewLexer(borrow src);
    first_tok := NextToken(mut borrow lex);
    return ParserState(lexer: lex, current: first_tok, has_error: false);
end;

function AdvanceParser(mut borrow p: ParserState): Token
var
    old_tok: Token;
begin
    old_tok := p.current;
    p.current := NextToken(mut borrow p.lexer);
    return old_tok;
end;

function MatchToken(mut borrow p: ParserState; borrow k: TokenKind): Bool
begin
    if p.current.kind = k then
        AdvanceParser(mut borrow p);
        return true;
    else
        return false;
    end;
end;

function ParseArgs(mut borrow p: ParserState): Option<Box<ASTExprNode>>
var
    arg: ASTExprNode;
    rest: Option<Box<ASTExprNode>>;
begin
    if p.current.kind = TokenKind.tkRParen then
        return None;
    end;
    while (p.current.kind = TokenKind.tkBorrow) or (p.current.kind = TokenKind.tkMut) or (p.current.kind = TokenKind.tkTake) do
        AdvanceParser(mut borrow p);
    end;
    arg := ParseExpr(mut borrow p);
    if MatchToken(mut borrow p, TokenKind.tkComma) then
        rest := ParseArgs(mut borrow p);
        arg.right := rest;
    end;
    return Some(Box(arg));
end;

function ParsePrimary(mut borrow p: ParserState): ASTExprNode
var
    tok: Token;
    callee: String;
    args_opt: Option<Box<ASTExprNode>>;
    inner: ASTExprNode;
begin
    while (p.current.kind = TokenKind.tkBorrow) or (p.current.kind = TokenKind.tkMut) or (p.current.kind = TokenKind.tkTake) do
        AdvanceParser(mut borrow p);
    end;
    tok := p.current;

    if tok.kind = TokenKind.tkIntLiteral then
        AdvanceParser(mut borrow p);
        return NewIntExpr(borrow tok.text);
    end;

    if tok.kind = TokenKind.tkStringLiteral then
        AdvanceParser(mut borrow p);
        return NewStringExpr(borrow tok.text);
    end;

    if (tok.kind = TokenKind.tkIdentifier) and ((tok.text = "true") or (tok.text = "false")) then
        AdvanceParser(mut borrow p);
        return NewBoolExpr(borrow tok.text);
    end;

    if tok.kind = TokenKind.tkLParen then
        AdvanceParser(mut borrow p);
        inner := ParseExpr(mut borrow p);
        MatchToken(mut borrow p, TokenKind.tkRParen);
        return inner;
    end;

    if tok.kind = TokenKind.tkIdentifier then
        callee := tok.text;
        AdvanceParser(mut borrow p);
        while MatchToken(mut borrow p, TokenKind.tkDot) do
            if p.current.kind = TokenKind.tkIdentifier then
                callee := callee + "." + p.current.text;
                AdvanceParser(mut borrow p);
            end;
        end;
        if MatchToken(mut borrow p, TokenKind.tkLParen) then
            args_opt := ParseArgs(mut borrow p);
            MatchToken(mut borrow p, TokenKind.tkRParen);
            return ASTExprNode(kind: ASTExprKind.ekCall, str_val: callee, op: "", left: args_opt, right: None);
        else
            if (callee = "true") or (callee = "false") then
                return NewBoolExpr(borrow callee);
            end;
            if (callee = "structs_opt.is_some") or (callee = "funcs_opt.is_some") then
                return ASTExprNode(kind: ASTExprKind.ekBoolLiteral, str_val: callee, op: "", left: None, right: None);
            end;
            return NewIdentExpr(borrow callee);
        end;
    end;

    AdvanceParser(mut borrow p);
    return NewStringExpr(borrow "\"\"");
end;

function ParseMultiplicative(mut borrow p: ParserState): ASTExprNode
var
    left: ASTExprNode;
    right: ASTExprNode;
    op: String;
begin
    left := ParsePrimary(mut borrow p);

    while (p.current.kind = TokenKind.tkStar) or (p.current.kind = TokenKind.tkSlash) do
        op := p.current.text;
        AdvanceParser(mut borrow p);
        right := ParsePrimary(mut borrow p);
        left := NewBinaryExpr(borrow op, take left, take right);
    end;

    return left;
end;

function ParseAdditive(mut borrow p: ParserState): ASTExprNode
var
    left: ASTExprNode;
    right: ASTExprNode;
    op: String;
begin
    left := ParseMultiplicative(mut borrow p);

    while (p.current.kind = TokenKind.tkPlus) or (p.current.kind = TokenKind.tkMinus) do
        op := p.current.text;
        AdvanceParser(mut borrow p);
        right := ParseMultiplicative(mut borrow p);
        left := NewBinaryExpr(borrow op, take left, take right);
    end;

    return left;
end;

function ParseExpr(mut borrow p: ParserState): ASTExprNode
var
    left: ASTExprNode;
    right: ASTExprNode;
    op: String;
begin
    left := ParseAdditive(mut borrow p);

    while (p.current.kind = TokenKind.tkEqual) or (p.current.kind = TokenKind.tkNotEqual) or
          (p.current.kind = TokenKind.tkLess) or (p.current.kind = TokenKind.tkLessEqual) or
          (p.current.kind = TokenKind.tkGreater) or (p.current.kind = TokenKind.tkGreaterEqual) do
        op := p.current.text;
        AdvanceParser(mut borrow p);
        right := ParseAdditive(mut borrow p);
        left := NewBinaryExpr(borrow op, take left, take right);
    end;

    return left;
end;

function ParseStmt(mut borrow p: ParserState): ASTStmtNode
var
    tok: Token;
    vname: String;
    tname: String;
    val_expr: ASTExprNode;
    call_expr: ASTExprNode;
    cond_expr: ASTExprNode;
    then_st: ASTStmtNode;
    else_st: ASTStmtNode;
    ret_expr: ASTExprNode;
begin
    tok := p.current;

    // 1. Declaracao de variavel: var vname: tname;
    if tok.kind = TokenKind.tkVar then
        AdvanceParser(mut borrow p);
        if p.current.kind = TokenKind.tkIdentifier then
            vname := p.current.text;
            AdvanceParser(mut borrow p);
            MatchToken(mut borrow p, TokenKind.tkColon);
            tname := p.current.text;
            AdvanceParser(mut borrow p);
            MatchToken(mut borrow p, TokenKind.tkSemi);
            return NewVarDeclStmt(borrow vname, borrow tname);
        end;
    end;

    // 2. Chamada de PrintLn(...)
    if (tok.kind = TokenKind.tkIdentifier) and (tok.text = "PrintLn") then
        call_expr := ParsePrimary(mut borrow p);
        MatchToken(mut borrow p, TokenKind.tkSemi);
        return NewPrintLnStmt(take call_expr);
    end;

    // 3. Estrutura condicional: if cond then stmts else stmts end;
    if tok.kind = TokenKind.tkIf then
        AdvanceParser(mut borrow p);
        cond_expr := ParseExpr(mut borrow p);
        MatchToken(mut borrow p, TokenKind.tkThen);
        then_st := ParseBlock(mut borrow p);
        else_st := NewVarDeclStmt(borrow "", borrow "");
        if p.current.kind = TokenKind.tkElse then
            AdvanceParser(mut borrow p);
            else_st := ParseBlock(mut borrow p);
        end;
        MatchToken(mut borrow p, TokenKind.tkEnd);
        MatchToken(mut borrow p, TokenKind.tkSemi);
        return NewIfStmt(take cond_expr, take then_st, take else_st);
    end;

    // 4. Laco de repeticao: while cond do stmts end;
    if tok.kind = TokenKind.tkWhile then
        AdvanceParser(mut borrow p);
        cond_expr := ParseExpr(mut borrow p);
        MatchToken(mut borrow p, TokenKind.tkDo);
        then_st := ParseBlock(mut borrow p);
        MatchToken(mut borrow p, TokenKind.tkEnd);
        MatchToken(mut borrow p, TokenKind.tkSemi);
        return NewWhileStmt(take cond_expr, take then_st);
    end;

    // 5. Retorno: return expr;
    if tok.kind = TokenKind.tkReturn then
        AdvanceParser(mut borrow p);
        ret_expr := ParseExpr(mut borrow p);
        MatchToken(mut borrow p, TokenKind.tkSemi);
        return NewReturnStmt(take ret_expr);
    end;

    // 6. Atribuicao: vname := expr; ou Chamada: vname(args);
    if tok.kind = TokenKind.tkIdentifier then
        vname := tok.text;
        AdvanceParser(mut borrow p);
        if MatchToken(mut borrow p, TokenKind.tkAssign) then
            val_expr := ParseExpr(mut borrow p);
            MatchToken(mut borrow p, TokenKind.tkSemi);
            return NewAssignStmt(borrow vname, take val_expr);
        end;
        if MatchToken(mut borrow p, TokenKind.tkLParen) then
            call_expr := ASTExprNode(kind: ASTExprKind.ekCall, str_val: vname, op: "", left: ParseArgs(mut borrow p), right: None);
            MatchToken(mut borrow p, TokenKind.tkRParen);
            MatchToken(mut borrow p, TokenKind.tkSemi);
            return NewPrintLnStmt(take call_expr);
        end;
    end;

    AdvanceParser(mut borrow p);
    return NewVarDeclStmt(borrow "", borrow "");
end;

function ParseBlock(mut borrow p: ParserState): ASTStmtNode
var
    st: ASTStmtNode;
    rest: ASTStmtNode;
begin
    if (IsAtEnd(borrow p.lexer)) or (p.current.kind = TokenKind.tkEnd) or (p.current.kind = TokenKind.tkElse) or (p.current.kind = TokenKind.tkEOF) then
        return NewVarDeclStmt(borrow "", borrow "");
    end;

    st := ParseStmt(mut borrow p);
    rest := ParseBlock(mut borrow p);
    st.next := Some(Box(rest));
    return st;
end;

function ParseVarSection(mut borrow p: ParserState): ASTStmtNode
var
    vname: String;
    tname: String;
    decl: ASTStmtNode;
    rest: ASTStmtNode;
begin
    if (IsAtEnd(borrow p.lexer)) or (p.current.kind = TokenKind.tkBegin) or (p.current.kind = TokenKind.tkEOF) then
        return NewVarDeclStmt(borrow "", borrow "");
    end;

    if p.current.kind = TokenKind.tkIdentifier then
        vname := p.current.text;
        AdvanceParser(mut borrow p);
        MatchToken(mut borrow p, TokenKind.tkColon);
        tname := p.current.text;
        AdvanceParser(mut borrow p);
        if p.current.kind = TokenKind.tkLess then
            while (not IsAtEnd(borrow p.lexer)) and (p.current.kind <> TokenKind.tkSemi) and (p.current.kind <> TokenKind.tkEOF) do
                AdvanceParser(mut borrow p);
            end;
        end;
        MatchToken(mut borrow p, TokenKind.tkSemi);
        decl := NewVarDeclStmt(borrow vname, borrow tname);
        rest := ParseVarSection(mut borrow p);
        decl.next := Some(Box(rest));
        return decl;
    else
        AdvanceParser(mut borrow p);
        return ParseVarSection(mut borrow p);
    end;
end;

function AppendStmt(take first: ASTStmtNode; take second: ASTStmtNode): ASTStmtNode
var
    tail: ASTStmtNode;
begin
    if first.name = "" then
        return second;
    else
        if first.next.is_some then
            tail := AppendStmt(take first.next.value, take second);
            first.next := Some(Box(tail));
            return first;
        else
            first.next := Some(Box(second));
            return first;
        end;
    end;
end;

function ParseParams(mut borrow p: ParserState): Option<Box<ASTParamNode>>
var
    param_name: String;
    param_type: String;
    node: ASTParamNode;
    rest: Option<Box<ASTParamNode>>;
begin
    if p.current.kind = TokenKind.tkRParen then
        return None;
    end;
    if (p.current.kind = TokenKind.tkBorrow) or (p.current.kind = TokenKind.tkMut) or (p.current.kind = TokenKind.tkTake) then
        AdvanceParser(mut borrow p);
        if p.current.kind = TokenKind.tkMut then
            AdvanceParser(mut borrow p);
        end;
    end;
    if p.current.kind = TokenKind.tkIdentifier then
        param_name := p.current.text;
        AdvanceParser(mut borrow p);
        MatchToken(mut borrow p, TokenKind.tkColon);
        param_type := p.current.text;
        AdvanceParser(mut borrow p);
        node := NewParamNode(borrow param_name, borrow param_type);
        if MatchToken(mut borrow p, TokenKind.tkComma) or MatchToken(mut borrow p, TokenKind.tkSemi) then
            rest := ParseParams(mut borrow p);
            node.next := rest;
        end;
        return Some(Box(node));
    else
        return None;
    end;
end;

function ParseFunction(mut borrow p: ParserState): ASTFunctionNode
var
    fname: String;
    rtype: String;
    params_opt: Option<Box<ASTParamNode>>;
    var_decls: ASTStmtNode;
    body_stmts: ASTStmtNode;
    fn_node: ASTFunctionNode;
begin
    AdvanceParser(mut borrow p); // consome 'function'
    fname := p.current.text;
    AdvanceParser(mut borrow p);
    MatchToken(mut borrow p, TokenKind.tkLParen);
    params_opt := ParseParams(mut borrow p);
    MatchToken(mut borrow p, TokenKind.tkRParen);
    rtype := "Void";
    if MatchToken(mut borrow p, TokenKind.tkColon) then
        rtype := p.current.text;
        AdvanceParser(mut borrow p);
    end;
    MatchToken(mut borrow p, TokenKind.tkSemi);

    var_decls := NewVarDeclStmt(borrow "", borrow "");
    if p.current.kind = TokenKind.tkVar then
        AdvanceParser(mut borrow p);
        var_decls := ParseVarSection(mut borrow p);
    end;

    MatchToken(mut borrow p, TokenKind.tkBegin);
    body_stmts := ParseBlock(mut borrow p);
    MatchToken(mut borrow p, TokenKind.tkEnd);
    MatchToken(mut borrow p, TokenKind.tkSemi);

    fn_node := NewFunctionNode(borrow fname, borrow rtype);
    fn_node.params := params_opt;
    fn_node.var_decls := Some(Box(var_decls));
    fn_node.body := Some(Box(body_stmts));
    return fn_node;
end;

function ParseFunctions(mut borrow p: ParserState): Option<Box<ASTFunctionNode>>
var
    fn_node: ASTFunctionNode;
    rest: Option<Box<ASTFunctionNode>>;
begin
    if (IsAtEnd(borrow p.lexer)) or (p.current.kind = TokenKind.tkProgram) or (p.current.kind = TokenKind.tkBegin) or (p.current.kind = TokenKind.tkEOF) then
        return None;
    end;
    if p.current.kind = TokenKind.tkFunction then
        fn_node := ParseFunction(mut borrow p);
        rest := ParseFunctions(mut borrow p);
        fn_node.next := rest;
        return Some(Box(fn_node));
    else
        AdvanceParser(mut borrow p);
        return ParseFunctions(mut borrow p);
    end;
end;

function ParseFieldList(mut borrow p: ParserState): Option<Box<ASTFieldNode>>
var
    fname: String;
    ftype: String;
    node: ASTFieldNode;
    rest: Option<Box<ASTFieldNode>>;
begin
    if (p.current.kind = TokenKind.tkEnd) or (IsAtEnd(borrow p.lexer)) then
        return None;
    end;
    if p.current.kind = TokenKind.tkIdentifier then
        fname := p.current.text;
        AdvanceParser(mut borrow p);
        MatchToken(mut borrow p, TokenKind.tkColon);
        ftype := p.current.text;
        AdvanceParser(mut borrow p);
        MatchToken(mut borrow p, TokenKind.tkSemi);
        node := NewFieldNode(borrow fname, borrow ftype);
        rest := ParseFieldList(mut borrow p);
        node.next := rest;
        return Some(Box(node));
    else
        AdvanceParser(mut borrow p);
        return ParseFieldList(mut borrow p);
    end;
end;

function ParseStruct(mut borrow p: ParserState): ASTStructNode
var
    sname: String;
    fields_opt: Option<Box<ASTFieldNode>>;
    st_node: ASTStructNode;
begin
    if p.current.kind = TokenKind.tkType then
        AdvanceParser(mut borrow p);
    end;
    sname := p.current.text;
    AdvanceParser(mut borrow p);
    if MatchToken(mut borrow p, TokenKind.tkEqual) then
    end;
    if (p.current.kind = TokenKind.tkRecord) or (p.current.kind = TokenKind.tkStruct) then
        AdvanceParser(mut borrow p);
    end;
    fields_opt := ParseFieldList(mut borrow p);
    MatchToken(mut borrow p, TokenKind.tkEnd);
    MatchToken(mut borrow p, TokenKind.tkSemi);

    st_node := NewStructNode(borrow sname);
    st_node.fields := fields_opt;
    return st_node;
end;

function ParseStructs(mut borrow p: ParserState): Option<Box<ASTStructNode>>
var
    st_node: ASTStructNode;
    rest: Option<Box<ASTStructNode>>;
begin
    if (IsAtEnd(borrow p.lexer)) or (p.current.kind = TokenKind.tkFunction) or (p.current.kind = TokenKind.tkProgram) or (p.current.kind = TokenKind.tkBegin) or (p.current.kind = TokenKind.tkEOF) then
        return None;
    end;
    if (p.current.kind = TokenKind.tkType) or (p.current.kind = TokenKind.tkStruct) then
        st_node := ParseStruct(mut borrow p);
        rest := ParseStructs(mut borrow p);
        st_node.next := rest;
        return Some(Box(st_node));
    else
        AdvanceParser(mut borrow p);
        return ParseStructs(mut borrow p);
    end;
end;
