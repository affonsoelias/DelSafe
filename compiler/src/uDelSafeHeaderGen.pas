unit uDelSafeHeaderGen;

{$mode objfpc}{$H+}

interface

uses
  SysUtils, Classes,
  uDelSafeAST;

type
  TDelSafeHeaderGenerator = class
  private
    FModule: TASTModule;
    FOutput: TStringList;

    procedure Emit(const Line: string = '');
    function MapTypeToC(const AType: string): string;
    function BuildFuncPrototype(Func: TASTFunction): string;
    procedure EmitRecordTypeDef(Rec: TASTRecordDecl);
  public
    constructor Create;
    destructor Destroy; override;
    function Generate(AModule: TASTModule): string;
  end;

function GenerateCHeader(AModule: TASTModule): string;
procedure SaveCHeaderToFile(AModule: TASTModule; const FilePath: string);

implementation

constructor TDelSafeHeaderGenerator.Create;
begin
  inherited Create;
  FOutput := TStringList.Create;
end;

destructor TDelSafeHeaderGenerator.Destroy;
begin
  FOutput.Free;
  inherited Destroy;
end;

procedure TDelSafeHeaderGenerator.Emit(const Line: string);
begin
  FOutput.Add(Line);
end;

function TDelSafeHeaderGenerator.MapTypeToC(const AType: string): string;
var
  T: string;
begin
  T := Trim(AType);
  if (T = 'Int32') or (T = 'Integer') or (T = 'Int') then Exit('int32_t');
  if (T = 'UInt32') or (T = 'Cardinal') or (T = 'DWord') then Exit('uint32_t');
  if (T = 'Int64') then Exit('int64_t');
  if (T = 'UInt64') or (T = 'QWord') then Exit('uint64_t');
  if (T = 'Int16') or (T = 'SmallInt') then Exit('int16_t');
  if (T = 'UInt16') or (T = 'Word') then Exit('uint16_t');
  if (T = 'Int8') or (T = 'ShortInt') then Exit('int8_t');
  if (T = 'UInt8') or (T = 'Byte') then Exit('uint8_t');
  if (T = 'Float32') or (T = 'Single') then Exit('float');
  if (T = 'Float64') or (T = 'Float') or (T = 'Double') or (T = 'Real') then Exit('double');
  if (T = 'Boolean') or (T = 'Bool') then Exit('bool');
  if (T = 'Char') then Exit('char');
  if (T = 'String') then Exit('const char*');
  if (T = 'Pointer') then Exit('void*');
  if (T = 'Void') or (T = '') then Exit('void');

  // Explicit pointers ^T
  if (Length(T) > 1) and (T[1] = '^') then
    Exit(MapTypeToC(Copy(T, 2, Length(T))) + '*');

  // Dynamic arrays: array of T -> Elem*
  if Pos('array of ', LowerCase(T)) = 1 then
    Exit(MapTypeToC(Trim(Copy(T, 10, Length(T)))) + '*');

  // User-defined types (Records / Structs)
  Result := T;
end;

procedure TDelSafeHeaderGenerator.EmitRecordTypeDef(Rec: TASTRecordDecl);
var
  I: Integer;
  Field: TASTRecordField;
begin
  if Rec.DocComment <> '' then
  begin
    Emit('/*');
    Emit(' * ' + StringReplace(Rec.DocComment, sLineBreak, sLineBreak + ' * ', [rfReplaceAll]));
    Emit(' */');
  end;

  Emit('typedef struct {');
  for I := 0 to Rec.Fields.Count - 1 do
  begin
    Field := TASTRecordField(Rec.Fields[I]);
    Emit(Format('    %s %s;', [MapTypeToC(Field.TypeName), Field.Name]));
  end;
  Emit(Format('} %s;', [Rec.Name]));
  Emit('');
end;

function TDelSafeHeaderGenerator.BuildFuncPrototype(Func: TASTFunction): string;
var
  I: Integer;
  Param: TASTParam;
  ParamsStr, ParamType, ModStr: string;
begin
  ParamsStr := '';
  for I := 0 to Func.Params.Count - 1 do
  begin
    Param := TASTParam(Func.Params[I]);
    ModStr := '';
    ParamType := MapTypeToC(Param.TypeName);

    if Param.Ownership = owMutBorrow then
      ModStr := '*'
    else if Param.Ownership = owBorrow then
    begin
      // If large record or string, can be a const pointer
      if (Param.TypeName <> 'Int32') and (Param.TypeName <> 'Int64') and
         (Param.TypeName <> 'Float64') and (Param.TypeName <> 'Boolean') and
         (Pos('*', ParamType) = 0) and (Param.TypeName <> 'String') then
        ModStr := '';
    end;

    ParamsStr := ParamsStr + Format('%s %s%s', [ParamType, ModStr, Param.Name]);
    if I < Func.Params.Count - 1 then
      ParamsStr := ParamsStr + ', ';
  end;

  if ParamsStr = '' then
    ParamsStr := 'void';

  Result := Format('DELSAFE_API %s %s(%s);', [MapTypeToC(Func.ReturnType), Func.Name, ParamsStr]);
end;

function TDelSafeHeaderGenerator.Generate(AModule: TASTModule): string;
var
  GuardName, VarItem, DimsStr: string;
  I, VIdx, DIdx: Integer;
  Func: TASTFunction;
  HasExports: Boolean;
begin
  FModule := AModule;
  FOutput.Clear;

  GuardName := 'DELSAFE_' + UpperCase(StringReplace(AModule.Name, '-', '_', [rfReplaceAll])) + '_H';

  Emit('/* ========================================================================== */');
  Emit('/*  C Header automatically generated by the DelSafe Compiler (delsafec)       */');
  Emit(Format('/*  Module: %s                                                         */', [AModule.Name]));
  Emit('/*  Standard: C99 / C++ compatible with native binary ABI                   */');
  Emit('/* ========================================================================== */');
  Emit('');
  Emit(Format('#ifndef %s', [GuardName]));
  Emit(Format('#define %s', [GuardName]));
  Emit('');
  Emit('#include <stdint.h>');
  Emit('#include <stdbool.h>');
  Emit('#include <stddef.h>');
  Emit('');
  Emit('#ifdef __cplusplus');
  Emit('extern "C" {');
  Emit('#endif');
  Emit('');
  Emit('#if defined(_WIN32) || defined(__CYGWIN__)');
  Emit('  #if defined(DELSAFE_BUILD_DLL)');
  Emit('    #define DELSAFE_API __declspec(dllexport)');
  Emit('  #else');
  Emit('    #define DELSAFE_API __declspec(dllimport)');
  Emit('  #endif');
  Emit('#else');
  Emit('  #if defined(DELSAFE_BUILD_DLL)');
  Emit('    #define DELSAFE_API __attribute__((visibility("default")))');
  Emit('  #else');
  Emit('    #define DELSAFE_API');
  Emit('  #endif');
  Emit('#endif');
  Emit('');

  // Declare types/records/enums/aliases/subranges/arrays
  if AModule.Types.Count > 0 then
  begin
    Emit('/* --- Exported Types and Records --- */');
    for I := 0 to AModule.Types.Count - 1 do
    begin
      if AModule.Types[I] is TASTRecordDecl then
        EmitRecordTypeDef(TASTRecordDecl(AModule.Types[I]))
      else if AModule.Types[I] is TASTEnumDecl then
      begin
        Emit('typedef enum {');
        for VIdx := 0 to TASTEnumDecl(AModule.Types[I]).Variants.Count - 1 do
        begin
          VarItem := TASTEnumDecl(AModule.Types[I]).Name + '_' +
            TASTEnumVariant(TASTEnumDecl(AModule.Types[I]).Variants[VIdx]).Name;
          if VIdx < TASTEnumDecl(AModule.Types[I]).Variants.Count - 1 then
            Emit('    ' + VarItem + ',')
          else
            Emit('    ' + VarItem);
        end;
        Emit(Format('} %s;', [TASTEnumDecl(AModule.Types[I]).Name]));
        Emit('');
      end
      else if AModule.Types[I] is TASTTypeAliasDecl then
      begin
        Emit(Format('typedef %s %s;', [
          MapTypeToC(TASTTypeAliasDecl(AModule.Types[I]).TargetType),
          TASTTypeAliasDecl(AModule.Types[I]).Name]));
        Emit('');
      end
      else if AModule.Types[I] is TASTSubrangeDecl then
      begin
        if SameText(TASTSubrangeDecl(AModule.Types[I]).BaseType, 'Char') then
          Emit(Format('typedef char %s;', [TASTSubrangeDecl(AModule.Types[I]).Name]))
        else
          Emit(Format('typedef int32_t %s;', [TASTSubrangeDecl(AModule.Types[I]).Name]));
        Emit('');
      end
      else if AModule.Types[I] is TASTArrayDecl then
      begin
        if TASTArrayDecl(AModule.Types[I]).Dims.Count = 0 then
          Emit(Format('typedef %s* %s;', [
            MapTypeToC(TASTArrayDecl(AModule.Types[I]).ElemType),
            TASTArrayDecl(AModule.Types[I]).Name]))
        else
        begin
          DimsStr := '';
          for DIdx := 0 to TASTArrayDecl(AModule.Types[I]).Dims.Count - 1 do
            DimsStr := DimsStr + '[' + TASTArrayDecl(AModule.Types[I]).Dims[DIdx] + ']';
          Emit(Format('typedef %s %s%s;', [
            MapTypeToC(TASTArrayDecl(AModule.Types[I]).ElemType),
            TASTArrayDecl(AModule.Types[I]).Name,
            DimsStr]));
        end;
        Emit('');
      end;
    end;
  end;

  // Declare exported functions
  Emit('/* --- Exported Functions with C Calling Convention (cdecl) --- */');
  HasExports := False;
  for I := 0 to AModule.Functions.Count - 1 do
  begin
    Func := TASTFunction(AModule.Functions[I]);
    if Func.IsExport then
    begin
      HasExports := True;
      if Func.DocComment <> '' then
      begin
        Emit('/*');
        Emit(' * ' + StringReplace(Func.DocComment, sLineBreak, sLineBreak + ' * ', [rfReplaceAll]));
        Emit(' */');
      end;
      Emit(BuildFuncPrototype(Func));
      Emit('');
    end;
  end;

  if not HasExports then
  begin
    // If no function explicitly has "export", export all public functions of the module
    for I := 0 to AModule.Functions.Count - 1 do
    begin
      Func := TASTFunction(AModule.Functions[I]);
      if not Func.IsExtern then
      begin
        if Func.DocComment <> '' then
        begin
          Emit('/*');
          Emit(' * ' + StringReplace(Func.DocComment, sLineBreak, sLineBreak + ' * ', [rfReplaceAll]));
          Emit(' */');
        end;
        Emit(BuildFuncPrototype(Func));
        Emit('');
      end;
    end;
  end;

  Emit('#ifdef __cplusplus');
  Emit('}');
  Emit('#endif');
  Emit('');
  Emit(Format('#endif /* %s */', [GuardName]));

  Result := FOutput.Text;
end;

function GenerateCHeader(AModule: TASTModule): string;
var
  Gen: TDelSafeHeaderGenerator;
begin
  Gen := TDelSafeHeaderGenerator.Create;
  try
    Result := Gen.Generate(AModule);
  finally
    Gen.Free;
  end;
end;

procedure SaveCHeaderToFile(AModule: TASTModule; const FilePath: string);
var
  HeaderCode: string;
  SL: TStringList;
begin
  HeaderCode := GenerateCHeader(AModule);
  SL := TStringList.Create;
  try
    SL.Text := HeaderCode;
    ForceDirectories(ExtractFileDir(FilePath));
    SL.SaveToFile(FilePath);
  finally
    SL.Free;
  end;
end;

end.
