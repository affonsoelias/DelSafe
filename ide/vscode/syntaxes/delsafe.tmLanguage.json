{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DelSafe",
  "scopeName": "source.delsafe",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords-control" },
    { "include": "#keywords-ownership" },
    { "include": "#keywords-contracts" },
    { "include": "#types-primitive" },
    { "include": "#types-monads" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.delsafe",
          "match": "//.*$"
        },
        {
          "name": "comment.block.delsafe",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.curly.delsafe",
          "begin": "\\{",
          "end": "\\}"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.delsafe",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.delsafe",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.delsafe",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.delsafe",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.delsafe",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.delsafe",
          "match": "\\b0x[0-9a-fA-F]+\\b|\\$[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.delsafe",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.language.boolean.delsafe",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "name": "keyword.control.module.delsafe",
          "match": "\\b(module|program|import|extern)\\b"
        },
        {
          "name": "keyword.control.type.delsafe",
          "match": "\\b(type|record|enum|trait|impl|for)\\b"
        },
        {
          "name": "keyword.control.block.delsafe",
          "match": "\\b(begin|end)\\b"
        },
        {
          "name": "keyword.control.flow.delsafe",
          "match": "\\b(if|then|else|while|do|match|case|return)\\b"
        },
        {
          "name": "keyword.declaration.variable.delsafe",
          "match": "\\b(var|let)\\b"
        },
        {
          "name": "keyword.declaration.function.delsafe",
          "match": "\\b(function)\\b"
        }
      ]
    },
    "keywords-ownership": {
      "patterns": [
        {
          "name": "storage.modifier.ownership.delsafe",
          "match": "\\b(borrow|take|mut\\s+borrow|mut|own)\\b"
        }
      ]
    },
    "keywords-contracts": {
      "patterns": [
        {
          "name": "keyword.other.contract.delsafe",
          "match": "\\b(contract|require|ensure)\\b"
        }
      ]
    },
    "types-primitive": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.delsafe",
          "match": "\\b(Int8|Int16|Int32|Int64|UInt8|UInt16|UInt32|UInt64|Float32|Float64|Bool|String|Void|Pointer)\\b"
        }
      ]
    },
    "types-monads": {
      "patterns": [
        {
          "name": "entity.name.type.monad.delsafe",
          "match": "\\b(Result|Option|Box)\\b"
        },
        {
          "name": "support.function.constructor.delsafe",
          "match": "\\b(Ok|Err|Some|None)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.delsafe",
          "match": "\\b(and|or|not|implies|mod|div)\\b"
        },
        {
          "name": "keyword.operator.assignment.delsafe",
          "match": ":="
        },
        {
          "name": "keyword.operator.comparison.delsafe",
          "match": "(<=|>=|<>|<|>|=)"
        },
        {
          "name": "keyword.operator.arithmetic.delsafe",
          "match": "(\\+|\\-|\\*|\\/)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.delsafe",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  }
}
