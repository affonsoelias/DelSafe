{
  "name": "delsafe-lang",
  "displayName": "DelSafe Programming Language",
  "description": "Official smart support for the DelSafe language (LSP, Syntax Highlighting, Borrow Checker, Snippets, and Tests)",
  "version": "0.5.1",
  "publisher": "delsafe-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "delsafe",
    "pascal",
    "rust",
    "borrow-checker",
    "ownership",
    "c99",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:delsafe"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "delsafe",
        "aliases": [
          "DelSafe",
          "delsafe"
        ],
        "extensions": [
          ".dels"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "delsafe",
        "scopeName": "source.delsafe",
        "path": "./syntaxes/delsafe.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "delsafe",
        "path": "./snippets/delsafe.json"
      }
    ],
    "commands": [
      {
        "command": "delsafe.build",
        "title": "DelSafe: Compile Current File (Pascal Backend)",
        "category": "DelSafe"
      },
      {
        "command": "delsafe.buildC",
        "title": "DelSafe: Compile Current File (C99 / GCC Backend)",
        "category": "DelSafe"
      },
      {
        "command": "delsafe.runTests",
        "title": "DelSafe: Run Unit Tests (delsafec test)",
        "category": "DelSafe"
      },
      {
        "command": "delsafe.restartLSP",
        "title": "DelSafe: Restart Language Server (LSP)",
        "category": "DelSafe"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "DelSafe Language Configuration",
      "properties": {
        "delsafe.compilerPath": {
          "type": "string",
          "default": "delsafec",
          "description": "Absolute or relative path to the DelSafe compiler executable (delsafec / delsafec.exe)."
        },
        "delsafe.defaultBackend": {
          "type": "string",
          "enum": [
            "pascal",
            "c"
          ],
          "default": "pascal",
          "description": "Default compilation backend used by build commands and tests."
        },
        "delsafe.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace and logging verbosity level for Language Server (LSP) messages."
        }
      }
    }
  }
}
