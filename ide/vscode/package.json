{
  "name": "aether-lang",
  "displayName": "Aether Programming Language",
  "description": "Official smart support for the Aether language (LSP, Syntax Highlighting, Borrow Checker, Snippets, and Tests)",
  "version": "0.5.0",
  "publisher": "aether-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "aether",
    "pascal",
    "rust",
    "borrow-checker",
    "ownership",
    "c99",
    "lsp"
  ],
  "activationEvents": [
    "onLanguage:aether"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "aether",
        "aliases": [
          "Aether",
          "aether"
        ],
        "extensions": [
          ".aeth"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aether",
        "scopeName": "source.aether",
        "path": "./syntaxes/aether.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aether",
        "path": "./snippets/aether.json"
      }
    ],
    "commands": [
      {
        "command": "aether.build",
        "title": "Aether: Compile Current File (Pascal Backend)",
        "category": "Aether"
      },
      {
        "command": "aether.buildC",
        "title": "Aether: Compile Current File (C99 / GCC Backend)",
        "category": "Aether"
      },
      {
        "command": "aether.runTests",
        "title": "Aether: Run Unit Tests (aetherc test)",
        "category": "Aether"
      },
      {
        "command": "aether.restartLSP",
        "title": "Aether: Restart Language Server (LSP)",
        "category": "Aether"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Aether Language Configuration",
      "properties": {
        "aether.compilerPath": {
          "type": "string",
          "default": "aetherc",
          "description": "Absolute or relative path to the Aether compiler executable (aetherc / aetherc.exe)."
        },
        "aether.defaultBackend": {
          "type": "string",
          "enum": [
            "pascal",
            "c"
          ],
          "default": "pascal",
          "description": "Default compilation backend used by build commands and tests."
        },
        "aether.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace and logging verbosity level for Language Server (LSP) messages."
        }
      }
    }
  }
}
